// ZenLink (v2.5, generation "Next") main window. Same idea as v2: header with the everyday actions,
// the picture, a shortcut bar under it, and Settings docked at the side.
// The window hugs the picture; opening Settings widens it, closing shrinks it.

import { ScrollView } from "std-widgets.slint";
import { Theme, I18n } from "theme.slint";
import { Glass, Icon, GlassButton, Seg, LangPicker, Toggle, GlassSlider, Row, Card, Chip, Tip, UiTest, TrafficLights } from "widgets.slint";
// v2.5.1: an Android app in its own window (ZenLink.exe --android-app).
export { AppWin } from "appwin.slint";
import { FilePane, Files, FileRow, PlaceRow } from "filewin.slint";
import { DeviceRail, RailDev } from "devices.slint";
export { Files, FileRow, PlaceRow, RailDev }

export { Theme, I18n, UiTest }

// Smart Encoder Detection results for the selected Android device (A5),
// filled from Rust.
export global AndroidEnc {
    // Encoder choices for the selected codec: "" = Auto, then MediaCodec names.
    in property <[string]> options: [""];
    in property <[string]> labels: ["Auto"];
    // Codecs both ends support (empty = not detected yet).
    in property <[string]> codecs;
    // e.g. "H.264: 2 (1 hw) · H.265: 1 (1 hw)".
    in property <string> detected;
    // What the running session uses, e.g. "H.264 · c2.qti.avc.encoder".
    in property <string> using;
}

export struct Prefs {
    theme: string,          // light | dark | system
    glass-on: bool,         // Liquid Glass on; off = solid window
    glass: float,           // thickness 0..100: 0 = fully clear, 100 = thick frosted
    lens: bool,             // refraction / lensing layer
    lang: string,           // id | en
    fit: string,            // contain | cover | fill
    fit-window: bool,
    rotation: string,       // auto | 0 | 90 | 180 | 270
    crop-l: float, crop-t: float, crop-r: float, crop-b: float,
    audio-out: string,      // pc (Windows only) | device | both
    volume: float,
    lip-sync: bool,
    audio-buffer: string,   // low | normal | high
    touch: bool,
    keyboard: bool,
    gestures: bool,
    start-with-windows: bool,
    close-action: string,
    auto-unlock: bool,
    unlock-on-lock: bool, // unlock again when the device locks while mirroring
    unlock-limit: bool, // at most 3 automatic unlocks in 30 s
    on-top: bool,
    ghost-key: string,      // F4 | F6 | F8 | F9: Ghost mode on/off (on top, clicks go through)
    ghost-opacity: float,   // 20..100 % while in Ghost mode
    stats: bool,
    dots: bool,             // animated dot background
    platform: string,       // "" | apple | android (first screen)
    remember-platform: bool,
    android-max-size: string, // 1280 | 1920 | 2560 | 0 (native), longest side
    android-fps: string,      // 30 | 60 | 90 | 120 | 144 (cap)
    android-bitrate: string,  // Mbps: 4 | 8 | 16 | 24 | 40
    android-codec: string,    // auto | h264 | h265
    android-profile: string,  // low-latency | balanced | high-quality | streaming | custom
    android-encoder: string,  // "" = automatic, else a MediaCodec name from the phone's list
    update-check: bool,       // look for a new version at start (v2.5.1)
    update-channel: string,   // "" = this build's own | stable | beta
}

// Window controls, Windows order (min, max, close) on the right, drawn as
// coloured dots with the Windows glyph always visible inside.
// The window's own header: no card of its own, it is the top of the glass
// window (no header-inside-a-header).
component TopBar inherits Rectangle {
    in property <string> device;
    in property <string> phase;
    in property <string> link;
    in property <string> stats;
    in property <bool> settings-open;
    in property <bool> menu-open;
    in property <bool> muted;
    callback menu();
    callback start();
    callback stop();
    callback restart();
    callback settings();
    callback mute();
    callback rotate();
    callback fit-next();
    callback window-action(string);
    in property <string> fit;
    in property <bool> compact;
    in property <bool> maximized;
    in property <bool> fullscreen;
    property <bool> live: phase == "streaming";
    in property <string> need; // the device needs something before Start ("" = ready)
    property <bool> blocked: !live && phase != "connecting" && phase != "activating" && device != "" && need != "";
    property <bool> busy: phase == "connecting" || phase == "activating";
    // AirPlay receiver on, waiting for the device to pick it.
    in property <bool> listening;
    height: 46px;
    // Empty header space moves the window; double-click maximises.
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.window-action("drag");
            }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 6px;
        alignment: stretch;
        // App identity: always visible, the wordmark only when there is room.
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../../../ZenshiroDev/resources/assets/logo-256.png");
                width: 24px;
                height: 24px;
            }
        }
        Text {
            text: "ZenLink";
            font-size: 14px;
            font-weight: 700;
            color: Theme.text;
            vertical-alignment: center;
        }
        // Status: a dot when narrow (name in its tooltip), a pill otherwise.
        if compact: VerticalLayout {
          alignment: center;
          Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: live ? Theme.accent : busy || blocked ? #f59e0b : #22c55e;
            border-width: 2px;
            border-color: Theme.dark ? #ffffff33 : #ffffffcc;
          }
        }
        if !compact: VerticalLayout {
          alignment: center;
          Rectangle {
            width: pillT.preferred-width + 16px;
            height: 24px;
            border-radius: 12px;
            background: live ? Theme.accent-soft : Theme.raise;
            border-width: 1px;
            border-color: Theme.line;
            pillT := Text {
                text: live ? I18n.t("Mirroring") : listening ? I18n.t("Waiting for the device") : busy ? I18n.t("Connecting…") : blocked ? I18n.t("Action needed") : I18n.t("Ready");
                font-size: 11px;
                font-weight: 600;
                color: live ? Theme.accent : Theme.text-2;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
          }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            if !compact: Text {
                text: device == "" ? I18n.t("No device") : device + (link == "" ? "" : "  ·  " + link);
                font-size: 11.5px;
                color: Theme.text-2;
                overflow: elide;
            }
            if stats != "": Text { text: stats; font-size: 10.5px; color: Theme.text-3; overflow: elide; font-family: "Cascadia Mono"; }
        }
        GlassButton {
            y: (parent.height - self.height) / 2;
            icon: "\u{E72C}";
            label: compact ? "" : I18n.t("Restart");
            tip: I18n.t("Restart the connection");
            clicked => { root.restart(); }
        }
        if !live && !busy: GlassButton {
            y: (parent.height - self.height) / 2;
            primary: true;
            icon: "\u{E768}";
            label: compact ? "" : I18n.t("Start");
            tip: I18n.t("Start mirroring");
            clicked => { root.start(); }
        }
        if live || busy: GlassButton {
            y: (parent.height - self.height) / 2;
            icon: "\u{E71A}";
            label: compact ? "" : "Stop";
            tip: I18n.t("Stop mirroring");
            clicked => { root.stop(); }
        }
        GlassButton {
            y: (parent.height - self.height) / 2;
            icon: muted ? "\u{E74F}" : "\u{E767}";
            tip: muted ? I18n.t("Sound off — click to turn on") : I18n.t("Sound on PC — click to mute");
            active: !muted;
            clicked => { root.mute(); }
        }
        if !compact: GlassButton {
            y: (parent.height - self.height) / 2;
            icon: "\u{E7AD}";
            clicked => { root.rotate(); }
            tip: I18n.t("Rotate view");
        }
        if !compact: GlassButton {
            y: (parent.height - self.height) / 2;
            label: fit == "contain" ? "AUTO" : fit == "cover" ? "EDGE" : "FILL";
            tip: I18n.t("View mode: Auto-Fit / Edge-to-Edge / Stretch");
            active: true;
            clicked => { root.fit-next(); }
        }
        GlassButton {
            y: (parent.height - self.height) / 2;
            icon: root.fullscreen ? "\u{E73F}" : "\u{E740}";
            active: root.fullscreen;
            tip: root.fullscreen ? I18n.t("Exit full screen") : I18n.t("Full screen");
            clicked => { root.window-action("fullscreen"); }
        }
        GlassButton {
            y: (parent.height - self.height) / 2;
            icon: "\u{E700}";
            active: menu-open;
            tip: I18n.t("Device menu");
            clicked => { root.menu(); }
        }
        GlassButton {
            y: (parent.height - self.height) / 2;
            icon: "\u{E713}";
            active: settings-open;
            tip: I18n.t("Settings");
            clicked => { root.settings(); }
        }
        Rectangle {
            width: 1px;
            background: Theme.dark ? #ffffff1f : #0000001a;
        }
        Rectangle { width: 2px; }
        TrafficLights {
            maximized: root.maximized;
            act(a) => { root.window-action(a); }
        }
    }
}

// ZenLink dock: a floating glass capsule centred under the picture,
// only as wide as its buttons (scrolls when the window is narrower).
component BottomBar inherits Rectangle {
    callback action(string);
    in property <bool> compact;
    // Android: its own buttons (Back, Home, Recents, panels, volume, power).
    in property <bool> android;
    height: 46px;
    dock := Glass {
        width: min(root.width, row.min-width);
        x: (root.width - self.width) / 2;
        height: root.height;
        border-radius: self.height / 2;
        fl := Flickable {
            content-width: max(self.width, row.min-width);
            interactive: row.min-width > self.width;
            row := HorizontalLayout {
                width: fl.content-width;
                height: dock.height;
                padding: 7px;
                padding-left: 9px;
                padding-right: 9px;
                spacing: 6px;
                alignment: center;
                if !root.android: Chip { icon: "\u{E76B}"; tip: I18n.t("Swipe from the right edge (forward)"); label: compact ? "" : I18n.t("Swipe left"); clicked => { root.action("swipe-left"); } }
                if root.android: Chip { icon: "\u{E72B}"; tip: I18n.t("Back (right click works too)"); label: compact ? "" : I18n.t("Back"); clicked => { root.action("back"); } }
                Chip { icon: "\u{E80F}"; tip: I18n.t("Home screen"); label: compact ? "" : "Home"; clicked => { root.action("home"); } }
                Chip { icon: "\u{E8A9}"; tip: I18n.t("Recent apps"); label: compact ? "" : "Recent"; clicked => { root.action("switcher"); } }
                if !root.android: Chip { icon: "\u{E76C}"; tip: I18n.t("Swipe from the left edge (back, also Alt+←)"); label: compact ? "" : I18n.t("Swipe right"); clicked => { root.action("swipe-right"); } }
                Rectangle { width: 1px; background: Theme.dark ? #ffffff1f : #0000001a; }
                if !root.android: Chip { icon: "\u{E9E9}"; tip: I18n.t("Control Center"); label: compact ? "" : "Control"; clicked => { root.action("control-center"); } }
                if root.android: Chip { icon: "\u{E71D}"; tip: I18n.t("Phone apps (open on the phone or in a new window)"); label: compact ? "" : I18n.t("Apps"); clicked => { root.action("apps"); } }
                if root.android: Chip { icon: "\u{E9E9}"; tip: I18n.t("Quick Settings"); label: compact ? "" : "Quick"; clicked => { root.action("quick-settings"); } }
                Chip { icon: "\u{EA8F}"; tip: I18n.t("Notifications"); label: compact ? "" : I18n.t("Alerts"); clicked => { root.action("notifications"); } }
                if root.android: Chip { icon: "\u{E993}"; tip: I18n.t("Phone volume down"); label: ""; clicked => { root.action("vol-down"); } }
                if root.android: Chip { icon: "\u{E995}"; tip: I18n.t("Phone volume up"); label: ""; clicked => { root.action("vol-up"); } }
                Chip { icon: "\u{E72E}"; tip: root.android ? I18n.t("Power button (lock / wake the screen)") : I18n.t("Lock screen"); label: compact ? "" : I18n.t("Lock"); clicked => { root.action("lock"); } }
            }
        }
    }
}

// One iPhone/iPad in the Apple device list: connected now, or trusted
// before and not connected ("offline").
/// One tile of the dot field (see dots.rs).
export struct DotTile {
    x: length,
    y: length,
    w: length,
    h: length,
    img: image,
}

export struct AppleDev {
    id: string,
    title: string,
    sub: string,
    // "ready" | "need" | "offline"
    state: string,
    wifi: bool,
    selected: bool,
}

// One step of the connect card (like v2: done / active / todo / failed).
component FlowStep inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <string> state; // "done" | "active" | "todo" | "failed"
    in property <bool> last;
    property <color> c: state == "done" ? Theme.ok : state == "active" ? #f0b43c : state == "failed" ? #ff6961 : Theme.text-3;
    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: state == "done" || state == "failed" ? c : transparent;
            border-width: state == "done" || state == "failed" ? 0px : 1.5px;
            border-color: state == "active" ? c.with-alpha(0.35) : c.with-alpha(0.5);
            if state == "done" || state == "failed": Text {
                text: state == "done" ? "\u{E73E}" : "\u{E711}";
                font-family: Theme.icons;
                font-size: 11px;
                color: #101010;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // Spinning arc while this step runs.
            if state == "active": Path {
                width: 22px;
                height: 22px;
                viewbox-width: 22;
                viewbox-height: 22;
                stroke: c;
                stroke-width: 2px;
                commands: "M 11 1.5 A 9.5 9.5 0 0 1 20.5 11";
                transform-rotation: (animation-tick() / 900ms) * 360deg;
            }
        }
        VerticalLayout {
            spacing: 3px;
            Text { text: title; font-size: 13.5px; font-weight: 600; color: state == "todo" ? Theme.text-3 : state == "active" ? c : Theme.text; }
            Text { text: sub; font-size: 11.5px; color: state == "active" ? Theme.text : Theme.text-3; wrap: word-wrap; }
        }
    }
    if !last: Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
}

// Shown in the stage while there is no picture: the device ready to start
// (phone, cable, name), then the 1-2-3-4 connect card like v2.
// Numbered how-to steps (1, 2, 3...) so anyone can follow them.
component HowTo inherits VerticalLayout {
    in property <[string]> steps;
    spacing: 9px;
    for s[i] in steps: HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: start;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: Theme.accent.with-alpha(0.16);
                border-width: 1px;
                border-color: Theme.accent.with-alpha(0.55);
                Text { text: "\{i + 1}"; font-size: 11.5px; font-weight: 700; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        Text { text: s; font-size: 12.5px; color: Theme.text-2; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
    }
}

component Placeholder inherits Rectangle {
    in property <string> phase;
    in property <string> device;
    in property <string> message;
    // Connect card: step -1 = hidden, 0..4; kind "apple" | "usbdirect" | "airplay".
    in property <int> flow-step: -1;
    in property <bool> flow-failed;
    in property <string> flow-kind: "apple";
    in property <bool> wifi;
    // What stands between the device and Start ("" = ready): restore, bind,
    // package, removefilter, mode, wifi, trust.
    in property <string> need;
    // Connection mode ("apple" | "usbdirect" | "") and link ("wired" | "wireless"),
    // switchable right here like in Settings > Connection & driver.
    in property <string> mode;
    in property <string> link: "wired";
    // Connected and saved devices; a click picks the one Start uses.
    in property <[AppleDev]> devices;
    // AirPlay receiver on (ZenLink Studio Wi-Fi): waiting for the device.
    in property <bool> listening;
    // Windows Firewall keeps the device out of the receiver; the button's result.
    in property <bool> firewall-blocked;
    in property <string> firewall-msg;
    callback allow-network();
    callback pick(string);
    callback forget(string);
    callback stop();
    callback start();
    callback dismiss();
    callback fix();
    callback set-link(string);
    callback change-mode();
    property <bool> card: flow-step >= 0;
    property <string> s-same-wifi: I18n.t("Connect the iPhone/iPad and the PC to the same Wi-Fi.");
    property <string> s-cc: I18n.t("On the iPhone/iPad, open Control Center: swipe down from the top-right corner of the screen.");
    property <string> s-tap: I18n.t("Tap Screen Mirroring (the two stacked rectangles).");
    property <string> s-pick: I18n.t("Pick ZenLinkStudio. The screen shows up here.");
    property <string> s-start: I18n.t("Press Start below.");
    // How to connect, step by step, while no device is there yet.
    property <[string]> steps: listening ? [s-same-wifi, s-cc, s-tap, s-pick]
        : device != "" ? []
        : air && mode == "usbdirect" ? [s-start, s-same-wifi, s-cc, s-tap, s-pick]
        : air ? [s-same-wifi,
            I18n.t("First time only: plug in the USB cable, then press Set up Wi-Fi in Settings › Connection & driver."),
            I18n.t("Unlock the iPhone/iPad, then press Start.")]
        : [I18n.t("Plug the iPhone/iPad into the PC with a USB cable."),
            I18n.t("Unlock its screen."),
            I18n.t("If it asks \"Trust this computer?\", tap Trust and enter the passcode."),
            s-start];
    property <bool> show-steps: message == "" && !(device != "" && need != "") && steps.length > 0;
    property <bool> air: link == "wireless";
    property <color> tone: device == "" ? Theme.text-3 : need != "" ? Theme.warn : Theme.ok;
    property <string> need-label: need == "trust" ? I18n.t("Needs Trust")
        : need == "wifi" ? I18n.t("Wi-Fi not set up")
        : need == "mode" ? I18n.t("Choose a mode")
        : I18n.t("Needs a driver");
    property <string> need-title: need == "restore" ? I18n.t("Restore the Apple driver")
        : need == "bind" ? I18n.t("Install the ZenLink Studio driver")
        : need == "package" ? I18n.t("libusb-win32 is not installed")
        : need == "removefilter" ? I18n.t("Remove the libusb0 filter first")
        : need == "mode" ? I18n.t("Choose a connection mode")
        : need == "wifi" ? I18n.t("Wi-Fi is not set up yet")
        : I18n.t("Unlock it and tap Trust");
    property <string> need-hint: need == "restore" ? I18n.t("This device uses the ZenLink Studio driver, so Apple mode cannot see it. Restore the Apple driver, or switch to ZenLink Studio.")
        : need == "bind" ? I18n.t("ZenLink Studio uses the libusb0 driver on the device. Install it, or switch to Apple Driver mode.")
        : need == "package" ? I18n.t("Install the iOS driver of TikTok LIVE Studio or libusb-win32 once, then press Check drivers. Or use Apple Driver mode.")
        : need == "removefilter" ? I18n.t("A libusb0 filter is stacked on the Apple driver. It can crash Windows.")
        : need == "mode" ? I18n.t("Pick Apple Driver or ZenLink Studio to continue.")
        : need == "wifi" ? I18n.t("Plug in the cable once, then press Set up Wi-Fi in Settings. Or choose Wired.")
        : I18n.t("Unlock the device, tap Trust if it asks, then try again.");
    property <[[string]]> texts: flow-kind == "usbdirect" ? [
            [I18n.t("Detect device"), I18n.t("Found on USB through the libusb0 driver")],
            [I18n.t("Open the device"), I18n.t("Switching it to its screen-capture mode")],
            [I18n.t("Check trust"), I18n.t("Keep it unlocked while ZenLink proves this PC is trusted")],
            [I18n.t("Start stream"), I18n.t("Receiving the screen over ZenLink Studio")]]
        : flow-kind == "airplay" ? [
            [I18n.t("Device connected"), I18n.t("Your iPhone/iPad chose ZenLinkStudio in Screen Mirroring")],
            [I18n.t("Secure connection"), I18n.t("AirPlay pairing and FairPlay key exchange")],
            [I18n.t("Receive video"), I18n.t("Decrypting the AirPlay stream")],
            [I18n.t("Start stream"), I18n.t("Receiving the screen over Wi-Fi")]]
        : [
            [I18n.t("Detect device"), I18n.t("Found through Apple Mobile Device Service")],
            [I18n.t("Secure connection"), wifi ? I18n.t("Opening an encrypted Wi-Fi tunnel to the device") : I18n.t("Opening an encrypted USB tunnel to the device")],
            [I18n.t("Prepare the device"), I18n.t("Keep it unlocked. The first time, a small developer image is installed.")],
            [I18n.t("Start stream"), I18n.t("Receiving the screen in HEVC")]];
    property <float> pct: max(0, min(flow-step, 4)) / 4;
    animate pct { duration: 420ms; easing: ease-out; }
    function st(i: int) -> string {
        if flow-failed && i == max(flow-step, 0) { return "failed"; }
        if i < flow-step { return "done"; }
        if i == flow-step { return "active"; }
        return "todo";
    }

    // Ready / plug-in view.
    if !card: VerticalLayout {
        alignment: center;
        spacing: 12px;
        padding-left: 24px;
        padding-right: 24px;
        Rectangle {
            height: 196px;
            // Phone outline with its cable.
            Rectangle {
                x: (parent.width - 86px) / 2;
                y: 0px;
                width: 86px;
                height: 160px;
                border-radius: 18px;
                border-width: 2px;
                border-color: root.tone;
                background: Theme.dark ? #ffffff08 : #ffffff80;
                Rectangle { y: 8px; width: 26px; height: 6px; border-radius: 3px; background: root.tone; opacity: 0.6; }
            }
            if !wifi && !air: Rectangle {
                x: (parent.width - 2px) / 2;
                y: 160px;
                width: 2px;
                height: 36px;
                background: device == "" ? Theme.text-3.with-alpha(0.5) : root.tone;
            }
        }
        if device != "" && devices.length == 0 && !listening: HorizontalLayout {
            alignment: center;
            Rectangle {
                height: 28px;
                border-radius: 14px;
                background: Theme.dark ? #ffffff0d : #ffffffa0;
                border-width: 1px;
                border-color: root.tone.with-alpha(0.45);
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 14px;
                    spacing: 8px;
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: root.tone; }
                    }
                    Text { text: device; font-size: 12px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                    Text { text: "·"; color: Theme.text-3; vertical-alignment: center; }
                    Text { text: need != "" ? root.need-label : wifi ? I18n.t("Ready · Wi-Fi") : I18n.t("Ready"); font-size: 12px; font-weight: 600; color: root.tone; vertical-alignment: center; }
                }
            }
        }
        Text {
            text: listening ? I18n.t("Waiting for the iPhone / iPad")
                : device == "" ? I18n.t("Plug in an iPhone or iPad") : need != "" ? root.need-title : I18n.f("{device} ready", device);
            font-size: 20px;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
        }
        if !show-steps: Text {
            text: message != "" ? message
                : device != "" && need != "" ? root.need-hint
                : I18n.t("Unlock it, then press Start mirroring.");
            font-size: 12.5px;
            color: message != "" ? #ff8a80 : Theme.text-2;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if show-steps: HorizontalLayout {
            alignment: center;
            HowTo { width: min(root.width - 48px, 420px); steps: root.steps; }
        }
        // The device picked ZenLinkStudio but Windows Firewall turns it away.
        if listening && firewall-blocked: HorizontalLayout {
            alignment: center;
            Rectangle {
                width: min(root.width - 48px, 420px);
                border-radius: 12px;
                background: Theme.warn.with-alpha(0.10);
                border-width: 1px;
                border-color: Theme.warn.with-alpha(0.5);
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Text {
                        text: I18n.t("Windows Firewall blocks ZenLink, so the iPhone/iPad cannot connect. Press the button below, then choose Yes.");
                        font-size: 12px;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: LayoutAlignment.start;
                        GlassButton { primary: true; icon: "\u{E83D}"; label: I18n.t("Allow ZenLink on the network"); clicked => { root.allow-network(); } }
                    }
                    if firewall-msg != "": Text { text: firewall-msg; font-size: 11.5px; color: Theme.text-2; wrap: word-wrap; }
                }
            }
        }
        // Devices: connected ones and the ones trusted before.
        if devices.length > 0 && !listening: HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(root.width - 48px, 360px);
                spacing: 6px;
                for d in devices: Rectangle {
                    height: 44px;
                    border-radius: 12px;
                    background: d.selected ? (Theme.dark ? #ffffff14 : #ffffffd0) : devTa.has-hover ? (Theme.dark ? #ffffff0c : #ffffffa0) : (Theme.dark ? #ffffff06 : #ffffff70);
                    border-width: 1px;
                    border-color: d.selected ? Theme.accent.with-alpha(0.7) : Theme.line;
                    animate background, border-color { duration: 160ms; }
                    devTa := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.pick(d.id); }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: d.state == "live" ? Theme.accent : d.state == "ready" ? Theme.ok : d.state == "need" ? Theme.warn : Theme.text-3.with-alpha(0.6);
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 1px;
                            Text { text: d.title; font-size: 12.5px; font-weight: 600; color: d.state == "offline" ? Theme.text-2 : Theme.text; overflow: elide; }
                            Text { text: d.sub; font-size: 11px; color: Theme.text-3; overflow: elide; }
                        }
                        if d.selected: VerticalLayout {
                            alignment: center;
                            Text { text: "\u{E73E}"; font-family: Theme.icons; font-size: 12px; color: Theme.accent; }
                        }
                        if d.state == "offline": VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 26px;
                                height: 26px;
                                border-radius: 13px;
                                background: forgetTa.has-hover ? (Theme.dark ? #ffffff1a : #0000001a) : transparent;
                                Text { text: "\u{E711}"; font-family: Theme.icons; font-size: 10px; color: Theme.text-3; horizontal-alignment: center; vertical-alignment: center; }
                                forgetTa := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.forget(d.id); }
                                }
                            }
                        }
                    }
                }
            }
        }
        // Mode and Cable / Wi-Fi, the same choices as Settings > Connection & driver.
        if device == "" || need == "": HorizontalLayout {
            alignment: center;
            spacing: 8px;
            padding-top: 4px;
            GlassButton {
                icon: "\u{E8AB}";
                label: (mode == "usbdirect" ? "ZenLink Studio" : "Apple Driver") + " · " + I18n.t("Change");
                tip: I18n.t("Choose Apple Driver or ZenLink Studio");
                clicked => { root.change-mode(); }
            }
            Seg {
                width: 190px;
                height: 32px;
                options: ["wired", "wireless"];
                labels: [I18n.t("Wired (USB)"), "Wi-Fi"];
                value: root.link;
                changed(v) => { root.set-link(v); }
            }
        }
        if listening: HorizontalLayout {
            alignment: center;
            GlassButton { icon: "\u{E71A}"; label: I18n.t("Stop waiting"); clicked => { root.stop(); } }
        }
        if device == "" && !listening: HorizontalLayout {
            alignment: center;
            GlassButton { primary: true; icon: "\u{E768}"; label: I18n.t("Start"); clicked => { root.start(); } }
        }
        if device != "" && !listening: HorizontalLayout {
            alignment: center;
            if need == "" || need == "trust": GlassButton { primary: true; icon: "\u{E768}"; label: need == "" ? I18n.t("Start mirroring") : I18n.t("Try again"); clicked => { root.start(); } }
            if need != "" && need != "trust": GlassButton {
                primary: true;
                icon: "\u{E90F}";
                label: need == "restore" ? I18n.t("Restore Apple driver")
                    : need == "bind" ? I18n.t("Install driver")
                    : need == "removefilter" ? I18n.t("Remove filter")
                    : need == "mode" ? I18n.t("Choose mode")
                    : I18n.t("Open settings");
                clicked => { root.fix(); }
            }
        }
    }

    // Connect card (1-2-3-4) while connecting, with the error if it fails.
    if card: Rectangle {
        width: min(parent.width - 32px, 440px);
        height: cardL.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 18px;
        background: Theme.dark ? #161618f2 : #fbfbfdf2;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        cardL := VerticalLayout {
            padding: 20px;
            spacing: 6px;
            HorizontalLayout {
                Text {
                    text: flow-failed ? I18n.t("Couldn't connect")
                        : flow-step >= 4 ? I18n.t("Connected")
                        : device != "" ? I18n.f("Connecting to {device}", device)
                        : I18n.t("Connecting");
                    font-size: 17px;
                    font-weight: 700;
                    color: Theme.text;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text { text: round(pct * 100) + "%"; font-size: 11.5px; color: Theme.text-3; vertical-alignment: center; font-family: "Cascadia Mono"; }
            }
            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Theme.dark ? #ffffff1a : #0000001a;
                Rectangle {
                    x: 0px;
                    width: parent.width * pct;
                    border-radius: 2px;
                    background: flow-failed ? #ff6961 : Theme.text;
                }
            }
            Rectangle { height: 6px; }
            for t[i] in texts: FlowStep {
                title: t[0];
                sub: t[1];
                state: root.st(i);
                last: i == 3;
            }
            if flow-failed: VerticalLayout {
                spacing: 12px;
                padding-top: 6px;
                // Capped: a raw device error once spilled far below the card.
                Text { text: message; font-size: 12.5px; color: #ff8a80; wrap: word-wrap; overflow: elide; max-height: 96px; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    GlassButton { label: I18n.t("Close"); clicked => { root.dismiss(); } }
                    GlassButton { primary: true; icon: "\u{E72C}"; label: I18n.t("Try again"); clicked => { root.start(); } }
                }
            }
        }
    }
}

// One connection mode in the chooser: a selectable glass card.
component ModeCard inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> tag;
    in property <string> badge;
    in property <string> desc;
    in property <[{ ok: bool, text: string }]> points;
    in property <bool> selected;
    in property <color> tint;
    callback pick();
    border-radius: 16px;
    background: selected ? tint.with-alpha(Theme.dark ? 0.14 : 0.10) : ta.has-hover ? Theme.hover.with-alpha(Theme.dark ? 0.10 : 0.5) : (Theme.dark ? #ffffff08 : #ffffff73);
    border-width: selected ? 1.5px : 1px;
    border-color: selected ? tint : Theme.line;
    animate background, border-color { duration: 220ms; easing: ease-out; }
    transform-scale-x: ta.pressed ? 98.5% : 100%;
    transform-scale-y: ta.pressed ? 98.5% : 100%;
    animate transform-scale-x, transform-scale-y { duration: ta.pressed ? 120ms : 320ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.pick(); } }
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 10px;
                background: @linear-gradient(135deg, root.tint 0%, root.tint.darker(0.35) 100%);
                Icon { text: root.icon; color: white; font-size: 15px; }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: root.title; font-size: 14px; font-weight: 700; color: Theme.text; }
                Text { text: root.tag; font-size: 11px; color: Theme.text-2; }
            }
            if root.badge != "": VerticalLayout {
                alignment: start;
                Rectangle {
                    height: 20px;
                    width: badgeT.preferred-width + 14px;
                    border-radius: 10px;
                    background: root.tint.with-alpha(0.18);
                    badgeT := Text { text: root.badge; font-size: 10.5px; font-weight: 700; color: Theme.dark ? root.tint : root.tint.darker(0.5); }
                }
            }
            // Radio dot.
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    border-width: root.selected ? 0px : 1.5px;
                    border-color: Theme.text-3;
                    background: root.selected ? root.tint : transparent;
                    animate background { duration: 200ms; }
                    Rectangle {
                        width: root.selected ? 8px : 0px;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: white;
                        animate width { duration: 300ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                    }
                }
            }
        }
        Text { text: root.desc; font-size: 12px; color: Theme.text-2; wrap: word-wrap; }
        for p in root.points: HorizontalLayout {
            spacing: 7px;
            Icon {
                text: p.ok ? "\u{E73E}" : "\u{E711}";
                font-size: 10px;
                width: 14px;
                vertical-alignment: top;
                color: p.ok ? Theme.ok : Theme.text-3;
            }
            Text { text: p.text; font-size: 11.5px; color: p.ok ? Theme.text : Theme.text-2; wrap: word-wrap; horizontal-stretch: 1; }
        }
    }
}

// Small modal: driver confirmations, progress and results.
component NoticeSheet inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> ok;
    in property <string> cancel;
    callback answer(bool);
    property <float> t: 0;
    init => { self.t = 1; }
    animate t { duration: 300ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1); }
    background: #000000.with-alpha(0.5 * t);
    TouchArea { } // swallow clicks behind the sheet
    Glass {
        strong: true;
        background: Theme.dark ? #1c1c1ef2 : #f6f6f9f2;
        border-radius: 20px;
        width: min(parent.width - 24px, 440px);
        height: min(parent.height - 24px, ncol.preferred-height + 2px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + 20px * (1 - root.t);
        opacity: root.t;
        ncol := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { text: root.title; font-size: 16px; font-weight: 800; color: Theme.text; wrap: word-wrap; }
            Text { text: root.body; font-size: 12px; color: Theme.text-2; wrap: word-wrap; }
            if root.ok != "" || root.cancel != "": HorizontalLayout {
                alignment: end;
                spacing: 8px;
                if root.cancel != "": GlassButton { label: root.cancel; clicked => { root.answer(false); } }
                if root.ok != "": GlassButton { primary: true; label: root.ok; clicked => { root.answer(true); } }
            }
        }
    }
}

// Close button / Alt+F4 while the close action is "ask". choose(act, remember):
// act is "tray", "quit" or "" (cancel). Esc cancels, Enter takes the primary.
component CloseDialog inherits Rectangle {
    callback choose(string, bool);
    property <bool> remember;
    property <float> t: 0;
    init => { self.t = 1; keys.focus(); }
    animate t { duration: 300ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1); }
    background: #000000.with-alpha(0.5 * t);
    TouchArea { clicked => { root.choose("", false); } }
    keys := FocusScope {
        key-pressed(ev) => {
            if ev.text == Key.Escape { root.choose("", false); return accept; }
            if ev.text == Key.Return { root.choose("tray", root.remember); return accept; }
            reject
        }
    }
    Glass {
        strong: true;
        background: Theme.dark ? #1c1c1ef2 : #f6f6f9f2;
        border-radius: 20px;
        width: min(parent.width - 24px, 420px);
        height: min(parent.height - 24px, ccol.preferred-height + 2px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + 20px * (1 - root.t);
        opacity: root.t;
        TouchArea { } // clicks on the card don't cancel
        ccol := VerticalLayout {
            width: parent.width;
            padding: 20px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 12px;
                Image { source: @image-url("../../../ZenshiroDev/resources/assets/logo-256.png"); width: 36px; height: 36px; }
                Text { text: I18n.t("Close ZenLink?"); font-size: 16px; font-weight: 800; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
            }
            Text {
                text: I18n.t("ZenLink can keep running in the system tray so your devices stay connected.");
                font-size: 12px;
                color: Theme.text-2;
                wrap: word-wrap;
            }
            // The TouchArea covers the whole row (inside a layout it would only take a cell).
            Rectangle {
                height: rrow.preferred-height;
                accessible-role: checkbox;
                accessible-checked: root.remember;
                accessible-label: I18n.t("Remember my choice");
                TouchArea { mouse-cursor: pointer; clicked => { root.remember = !root.remember; } }
            rrow := HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Rectangle {
                    width: 18px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    background: root.remember ? Theme.accent : transparent;
                    border-width: root.remember ? 0px : 1.5px;
                    border-color: Theme.text-3;
                    if root.remember: Icon { text: "\u{E73E}"; font-size: 11px; color: white; }
                }
                Text { text: I18n.t("Remember my choice"); font-size: 12px; color: Theme.text; vertical-alignment: center; }
            }
            }
            if root.remember: Text {
                text: I18n.t("You can change this in Settings.");
                font-size: 11px;
                color: Theme.text-3;
            }
            HorizontalLayout {
                spacing: 8px;
                GlassButton { label: I18n.t("Cancel"); clicked => { root.choose("", false); } }
                Rectangle { horizontal-stretch: 1; }
                GlassButton { label: I18n.t("Quit ZenLink"); clicked => { root.choose("quit", root.remember); } }
                GlassButton { primary: true; icon: "\u{E73F}"; label: I18n.t("Minimize to tray"); clicked => { root.choose("tray", root.remember); } }
            }
        }
    }
}

// First-run (or "change mode") sheet: nothing connects and no driver
// changes until a mode is chosen here.
component ModeChooser inherits Rectangle {
    in property <bool> cancelable;
    in property <string> active;     // mode in use now ("" = none yet)
    in property <string> link: "wired";
    in property <bool> remember: true;
    in-out property <Prefs> prefs;
    callback prefs-changed(Prefs);
    callback choose(string, string, bool);
    callback cancel();
    callback back();
    property <string> pick: active;
    property <string> link-pick: link;
    property <bool> keep: remember;
    // Inside the stage (v2.6 HOME): no dimmed backdrop, the stage glass shows.
    in property <bool> inline;
    property <float> t: 0;
    init => { self.t = 1; }
    animate t { duration: 380ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1); }
    background: root.inline ? transparent : #000000.with-alpha(0.5 * t);
    TouchArea { } // swallow clicks behind the sheet
    sheet := Glass {
        strong: !root.inline;
        // A modal sheet stays readable at any glass thickness.
        background: root.inline ? transparent : Theme.dark ? #1c1c1ef2 : #f6f6f9f2;
        border-radius: 22px;
        width: min(parent.width - 24px, 560px);
        height: min(parent.height - 24px, col.preferred-height + 2px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + 24px * (1 - root.t);
        opacity: root.t;
        transform-scale-x: 0.96 + 0.04 * root.t;
        transform-scale-y: 0.96 + 0.04 * root.t;
        ScrollView {
            col := VerticalLayout {
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    Image { source: @image-url("../../../ZenshiroDev/resources/assets/logo-256.png"); width: 40px; height: 40px; }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text { text: I18n.t("How should ZenLink connect?"); font-size: 16px; font-weight: 800; color: Theme.text; wrap: word-wrap; }
                        Text { text: I18n.t("Nothing connects and no driver changes until you continue."); font-size: 11.5px; color: Theme.text-2; wrap: word-wrap; }
                    }
                    if root.cancelable: VerticalLayout { alignment: start; GlassButton { icon: "\u{E711}"; tip: I18n.t("Cancel"); clicked => { root.cancel(); } } }
                }
                // Inline on Home the language lives in Settings; keeps the stage uncrowded.
                if !root.inline: HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Bahasa / Language"; font-size: 11.5px; color: Theme.text-2; vertical-alignment: center; }
                    LangPicker {
                        width: 190px;
                        value: root.prefs.lang;
                        changed(v) => { root.prefs.lang = v; root.prefs-changed(root.prefs); }
                    }
                }
                ModeCard {
                    icon: "\u{E83D}";
                    tint: #22c55e;
                    title: "Apple Driver";
                    tag: I18n.t("Standard · full control");
                    badge: I18n.t("Recommended");
                    desc: I18n.t("Uses Apple's own driver. Most compatible, stable and easy.");
                    points: [
                        { ok: true, text: I18n.t("Up to 60 fps, HEVC (device-limited bitrate, about 4–6 Mbps)") },
                        { ok: true, text: I18n.t("Mouse touch, keyboard, gestures and buttons") },
                        { ok: true, text: I18n.t("Apple's own driver, nothing to install") },
                        { ok: true, text: I18n.t("Wired or Wi-Fi (after a one-time setup with the cable)") },
                        { ok: true, text: I18n.t("iOS 17–26: Hybrid Control (experimental)") },
                        { ok: false, text: I18n.t("iOS 16 or older: use ZenLink Studio") },
                    ];
                    selected: root.pick == "apple";
                    pick => { root.pick = "apple"; }
                }
                ModeCard {
                    icon: "\u{E945}";
                    tint: #ff5fa8;
                    title: "ZenLink Studio";
                    tag: I18n.t("For live streaming");
                    desc: I18n.t("Best quality for streaming: high bitrate (measured 12–30 Mbps), up to 60 fps, very low latency. Needs the libusb0 driver.");
                    points: [
                        { ok: true, text: I18n.t("Up to 60 fps, full native resolution over the cable, high-bitrate H.264") },
                        { ok: true, text: I18n.t("Wired (USB) or Wi-Fi (AirPlay, no driver)") },
                        { ok: false, text: I18n.t("Picture and sound only: no touch, keyboard or gestures") },
                        { ok: false, text: I18n.t("Apple apps can't see the device until you switch back") },
                    ];
                    selected: root.pick == "usbdirect";
                    pick => { root.pick = "usbdirect"; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: I18n.t("Connection"); font-size: 12px; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                    Seg {
                        width: 240px;
                        options: ["wired", "wireless"];
                        labels: [I18n.t("Wired"), "Wi-Fi"];
                        value: root.link-pick;
                        changed(v) => { root.link-pick = v; }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: I18n.t("Remember my choice"); font-size: 12px; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                    Toggle { checked: root.keep; toggled(v) => { root.keep = v; } }
                }
                if !root.inline: Text {
                    text: I18n.t("You can change it any time in Settings › Connection & driver. Changing it may need an app restart and reconnecting the cable.");
                    font-size: 11px;
                    color: Theme.text-3;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    GlassButton { icon: "\u{E72B}"; label: I18n.t("Back"); tip: I18n.t("Change device type"); clicked => { root.back(); } }
                    Rectangle { horizontal-stretch: 1; }
                    if root.cancelable: GlassButton { label: I18n.t("Cancel"); clicked => { root.cancel(); } }
                    GlassButton {
                        primary: true;
                        enabled: root.pick != "";
                        icon: "\u{E72A}";
                        label: I18n.t("Continue");
                        clicked => { root.choose(root.pick, root.link-pick, root.keep); }
                    }
                }
            }
        }
    }
}

// One platform on the first screen: a large selectable glass card.
// Click or Space selects it; Enter or a double-click also continues.
component PlatformCard inherits Rectangle {
    in property <string> icon;
    in property <string> glyph; // SVG path (24x24) drawn instead of the font icon
    in property <string> title;
    in property <string> desc;
    in property <[string]> points;
    in property <string> badge;
    in property <bool> selected;
    in property <color> tint;
    callback pick();
    callback activate();
    accessible-role: button;
    accessible-label: root.title;
    accessible-description: root.desc;
    accessible-action-default => { root.pick(); }
    // Wrapped text can be taller than the layout's estimate: keep room.
    min-height: col.preferred-height + 20px;
    border-radius: 18px;
    background: selected ? tint.with-alpha(Theme.dark ? 0.15 : 0.11) : ta.has-hover ? Theme.hover.with-alpha(Theme.dark ? 0.10 : 0.5) : (Theme.dark ? #ffffff08 : #ffffff73);
    border-width: selected || fs.has-focus ? 1.5px : 1px;
    border-color: selected ? tint : fs.has-focus ? Theme.accent : Theme.line;
    animate background, border-color { duration: 220ms; easing: ease-out; }
    transform-scale-x: ta.pressed ? 98.5% : 100%;
    transform-scale-y: ta.pressed ? 98.5% : 100%;
    animate transform-scale-x, transform-scale-y { duration: ta.pressed ? 120ms : 320ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
    fs := FocusScope {
        key-pressed(ev) => {
            if ev.text == " " { root.pick(); return accept; }
            if ev.text == Key.Return { root.pick(); root.activate(); return accept; }
            reject
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { fs.focus(); root.pick(); }
        double-clicked => { root.pick(); root.activate(); }
    }
    col := VerticalLayout {
        padding: 18px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 46px;
                height: 46px;
                border-radius: 14px;
                background: @linear-gradient(135deg, root.tint 0%, root.tint.darker(0.35) 100%);
                if root.glyph == "": Icon { text: root.icon; color: white; font-size: 22px; }
                if root.glyph != "": Path { width: 25px; height: 25px; viewbox-width: 24; viewbox-height: 24; commands: root.glyph; fill: white; }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 4px;
                Text { text: root.title; font-size: 16px; font-weight: 800; color: Theme.text; wrap: word-wrap; }
                if root.badge != "": HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        height: 20px;
                        width: badgeT.preferred-width + 14px;
                        border-radius: 10px;
                        background: root.tint.with-alpha(0.18);
                        badgeT := Text { text: root.badge; font-size: 10.5px; font-weight: 700; color: Theme.dark ? root.tint : root.tint.darker(0.5); }
                    }
                }
            }
            // Radio dot.
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    border-width: root.selected ? 0px : 1.5px;
                    border-color: Theme.text-3;
                    background: root.selected ? root.tint : transparent;
                    animate background { duration: 200ms; }
                    Rectangle {
                        width: root.selected ? 8px : 0px;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: white;
                        animate width { duration: 300ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                    }
                }
            }
        }
        Text { text: root.desc; font-size: 12px; color: Theme.text-2; wrap: word-wrap; }
        for p in root.points: HorizontalLayout {
            spacing: 7px;
            Icon { text: "\u{E73E}"; font-size: 10px; width: 14px; vertical-alignment: top; color: Theme.ok; }
            Text { text: p; font-size: 11.5px; color: Theme.text; wrap: word-wrap; horizontal-stretch: 1; }
        }
    }
}

// First screen (phase A2): which device family to connect. Nothing connects
// and no driver changes here; iPhone / iPad leads to the Apple mode chooser.
component PlatformSelector inherits Rectangle {
    in property <string> picked;          // "" | apple | android
    in property <bool> remember;
    in property <bool> apple-detected;
    in property <int> android-count;
    in-out property <Prefs> prefs;
    callback prefs-changed(Prefs);
    callback choose(string, bool);
    property <string> pick: picked;
    property <bool> keep: remember;
    property <string> apple-badge: root.apple-detected ? I18n.t("Detected") : "";
    property <string> android-badge: root.android-count > 0 ? (root.android-count + I18n.t(" detected")) : "";
    property <string> apple-desc: I18n.t("Mirror and control compatible Apple devices using USB or Wi-Fi.");
    property <string> android-title: I18n.t("Android Smartphone / Tablet");
    property <string> android-desc: I18n.t("High-performance Android mirroring and control over USB or Wi-Fi.");
    property <[string]> apple-points: [
        I18n.t("Apple Driver or ZenLink Studio"),
        I18n.t("Wired or Wi-Fi"),
    ];
    property <[string]> android-points: [
        I18n.t("Through ADB and scrcpy, no app on the phone"),
        I18n.t("Wired or Wi-Fi, any Android brand"),
    ];
    // Inside the stage (v2.6 HOME): no dimmed backdrop, the stage glass shows.
    in property <bool> inline;
    property <float> t: 0;
    init => { self.t = 1; }
    animate t { duration: 380ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1); }
    background: root.inline ? transparent : #000000.with-alpha(0.5 * t);
    TouchArea { } // swallow clicks behind the sheet
    sheet := Glass {
        strong: !root.inline;
        background: root.inline ? transparent : Theme.dark ? #1c1c1ef2 : #f6f6f9f2;
        border-radius: 22px;
        width: min(parent.width - 24px, 640px);
        height: min(parent.height - 24px, col.preferred-height + 2px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + 24px * (1 - root.t);
        opacity: root.t;
        transform-scale-x: 0.96 + 0.04 * root.t;
        transform-scale-y: 0.96 + 0.04 * root.t;
        property <bool> wide: self.width >= 560px;
        ScrollView {
            col := VerticalLayout {
                padding: 20px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 12px;
                    Image { source: @image-url("../../../ZenshiroDev/resources/assets/logo-256.png"); width: 44px; height: 44px; }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        // Brand: ZenLink is the app name; "Next" marks the generation (v2.5).
                        HorizontalLayout {
                            alignment: start;
                            spacing: 6px;
                            Text { text: I18n.t("Welcome to ZenLink"); font-size: 12px; font-weight: 600; color: Theme.accent; vertical-alignment: center; }
                            Text { text: "v" + AppInfo.version; font-size: 9.5px; font-weight: 700; letter-spacing: 1px; color: Theme.text-2; vertical-alignment: center; }
                        }
                        Text { text: I18n.t("Which device would you like to connect?"); font-size: 18px; font-weight: 800; color: Theme.text; wrap: word-wrap; }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Bahasa / Language"; font-size: 11.5px; color: Theme.text-2; vertical-alignment: center; }
                    LangPicker {
                        width: 190px;
                        value: root.prefs.lang;
                        changed(v) => { root.prefs.lang = v; root.prefs-changed(root.prefs); }
                    }
                }
                if sheet.wide: HorizontalLayout {
                    spacing: 12px;
                    PlatformCard {
                        horizontal-stretch: 1;
                        icon: "\u{E8EA}";
                        glyph: Glyphs.apple;
                        tint: #5ac8fa;
                        title: "iPhone / iPad";
                        desc: root.apple-desc;
                        points: root.apple-points;
                        badge: root.apple-badge;
                        selected: root.pick == "apple";
                        pick => { root.pick = "apple"; }
                        activate => { root.choose("apple", root.keep); }
                    }
                    PlatformCard {
                        horizontal-stretch: 1;
                        icon: "\u{E70A}";
                        glyph: Glyphs.android;
                        tint: #3ddc84;
                        title: root.android-title;
                        desc: root.android-desc;
                        points: root.android-points;
                        badge: root.android-badge;
                        selected: root.pick == "android";
                        pick => { root.pick = "android"; }
                        activate => { root.choose("android", root.keep); }
                    }
                }
                if !sheet.wide: VerticalLayout {
                    spacing: 10px;
                    PlatformCard {
                        icon: "\u{E8EA}";
                        glyph: Glyphs.apple;
                        tint: #5ac8fa;
                        title: "iPhone / iPad";
                        desc: root.apple-desc;
                        points: root.apple-points;
                        badge: root.apple-badge;
                        selected: root.pick == "apple";
                        pick => { root.pick = "apple"; }
                        activate => { root.choose("apple", root.keep); }
                    }
                    PlatformCard {
                        icon: "\u{E70A}";
                        glyph: Glyphs.android;
                        tint: #3ddc84;
                        title: root.android-title;
                        desc: root.android-desc;
                        points: root.android-points;
                        badge: root.android-badge;
                        selected: root.pick == "android";
                        pick => { root.pick = "android"; }
                        activate => { root.choose("android", root.keep); }
                    }
                }
                if root.apple-detected && root.android-count > 0: Text {
                    text: I18n.t("Apple and Android devices are both connected. Choose the one to mirror.");
                    font-size: 11.5px;
                    color: Theme.warn;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: I18n.t("Remember device type"); font-size: 12px; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                    Toggle { checked: root.keep; toggled(v) => { root.keep = v; } }
                }
                Text {
                    text: I18n.t("You can change it any time in Settings › Device type or with the Back button.");
                    font-size: 11px;
                    color: Theme.text-3;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    GlassButton {
                        primary: true;
                        enabled: root.pick != "";
                        icon: "\u{E72A}";
                        label: I18n.t("Continue");
                        clicked => { root.choose(root.pick, root.keep); }
                    }
                }
            }
        }
    }
}

export struct AndroidRow {
    title: string,
    sub: string,
    ok: bool,
    // Ready over USB with no Wi-Fi link yet: offer "Wi-Fi" (adb tcpip).
    wifi: bool,
    // Connected over USB and Wi-Fi at once: the user picks the link.
    both: bool,
    // The device Start uses (picked in this list or the device menu).
    selected: bool,
}

// One installed app in the app picker.
export struct AppRow {
    name: string,
    sub: string,
    // Launcher tile: one or two letters on a colour from the package name
    // (scrcpy gives no icons).
    letter: string,
    tint: color,
}

// One numbered instruction step: a plain wrapped Text (nested layouts
// measured wrapped text too short and overlapped the next element).
component StepRow inherits Text {
    font-size: 11.5px;
    color: Theme.text-2;
    wrap: word-wrap;
}

// Indeterminate progress: a short bar sliding left to right. It only
// animates while it is shown.
component BusyBar inherits Rectangle {
    height: 3px;
    border-radius: 1.5px;
    background: Theme.fill;
    clip: true;
    Rectangle {
        width: parent.width * 0.3;
        height: parent.height;
        border-radius: 1.5px;
        background: Theme.accent;
        x: (mod(animation-tick() / 1ms, 1400) / 1400) * parent.width * 1.3 - self.width;
    }
}

// A single-line glass text field (Wi-Fi address, pairing code).
component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> ti.text;
    in property <InputType> input-type: InputType.text;
    callback accepted();
    callback edited(string);
    height: 32px;
    horizontal-stretch: 1;
    border-radius: 10px;
    background: ti.has-focus ? Theme.fill-hover : Theme.fill;
    border-width: 0.75px;
    border-color: ti.has-focus ? Theme.accent : (Theme.glass > 0.01 ? Theme.rim : Theme.line);
    animate background, border-color { duration: 180ms; easing: ease-out; }
    TouchArea { mouse-cursor: MouseCursor.text; clicked => { ti.focus(); } }
    if ti.text == "": Text {
        x: 11px;
        text: root.placeholder;
        font-size: 12px;
        color: Theme.text-3;
        vertical-alignment: center;
        height: parent.height;
    }
    ti := TextInput {
        x: 11px;
        width: parent.width - 22px;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        input-type: root.input-type;
        font-size: 12px;
        color: Theme.text;
        selection-background-color: Theme.accent-soft;
        accepted => { root.accepted(); }
        edited => { root.edited(self.text); }
    }
}

// Android workspace: setup steps, the devices ADB sees, and Start per
// ready device (phase A3: video only).
// Android picture settings (scrcpy server options). Shown before Start and
// in Settings on the Android screen; a change restarts a running session.
component AndroidVideoCard inherits Card {
    in-out property <Prefs> prefs;
    // Windows can decode H.265 (HEVC Video Extensions or a GPU driver decoder).
    in property <bool> hevc-ok;
    callback changed(Prefs);
    title: I18n.t("Android video");
    icon: "\u{E714}";
    tint-a: #3ddc84;
    tint-b: #1f9d55;
    info: I18n.t("A profile fills in resolution, FPS, bitrate and codec; change one value and the profile becomes Custom. Each phone keeps its own settings (the same over USB and Wi-Fi). Encoders are read from the phone on the first mirroring; if the chosen encoder fails, ZenLink tries another hardware encoder, then H.264, at most 4 times, and keeps your choice.");
    Row { label: "Profile"; }
    Seg {
        options: ["low-latency", "balanced", "high-quality", "streaming", "custom"];
        labels: ["Low Latency", "Balanced", "High Quality", "Streaming", "Custom"];
        value: prefs.android-profile;
        changed(v) => { root.prefs.android-profile = v; root.changed(root.prefs); }
    }
    Row { label: I18n.t("Resolution"); hint: I18n.t("Longest side."); }
    Seg {
        options: ["1280", "1920", "2560", "0"];
        labels: ["720p", "1080p", "1440p", "Native"];
        value: prefs.android-max-size;
        changed(v) => { root.prefs.android-max-size = v; root.changed(root.prefs); }
    }
    Row { label: "FPS"; hint: I18n.t("A cap; the phone never goes above its refresh rate."); }
    Seg {
        options: ["30", "60", "90", "120", "144"];
        labels: ["30", "60", "90", "120", "144"];
        value: prefs.android-fps;
        changed(v) => { root.prefs.android-fps = v; root.changed(root.prefs); }
    }
    Row { label: "Bitrate"; }
    Seg {
        options: ["4", "8", "16", "24", "40"];
        labels: ["4", "8", "16", "24", "40 Mbps"];
        value: prefs.android-bitrate;
        changed(v) => { root.prefs.android-bitrate = v; root.changed(root.prefs); }
    }
    // Codecs: what both the phone and Windows support once detected; before
    // that, what Windows can decode.
    property <bool> h265-ok: AndroidEnc.codecs.length > 0 ? (AndroidEnc.codecs.length > 1 && AndroidEnc.codecs[1] == "h265") : root.hevc-ok;
    Row {
        label: "Codec";
        hint: !root.hevc-ok ? I18n.t("H.265 needs HEVC Video Extensions on Windows.")
            : AndroidEnc.codecs.length == 1 ? I18n.t("This phone has no H.265 encoder.")
            : I18n.t("Auto = H.264, the lowest latency.");
    }
    Seg {
        options: root.h265-ok ? ["auto", "h264", "h265"] : ["auto", "h264"];
        labels: root.h265-ok ? ["Auto", "H.264", "H.265 (HEVC)"] : ["Auto", "H.264"];
        value: prefs.android-codec;
        changed(v) => { root.prefs.android-codec = v; root.changed(root.prefs); }
    }
    Row {
        label: "Encoder";
        hint: AndroidEnc.detected != "" ? AndroidEnc.detected : I18n.t("Detected on the first mirroring.");
    }
    if AndroidEnc.options.length > 1: Seg {
        options: AndroidEnc.options;
        labels: AndroidEnc.labels;
        value: prefs.android-encoder;
        changed(v) => { root.prefs.android-encoder = v; root.changed(root.prefs); }
    }
    if AndroidEnc.using != "": Row {
        label: I18n.t("In use");
        hint: AndroidEnc.using;
    }
}

// Android over Wi-Fi without a cable (QR, pairing code, IP:port): on the
// Android page and on "Connect a device".
// A plain box, not a Card: Card's folding clip measured this wrapped text
// too short and cut off "Option 2" (no title here, so folding is unused).
component AndroidWifiCard inherits Rectangle {
    background: Theme.card;
    border-radius: 18px;
    border-width: 1px;
    border-color: Theme.line;
    // Wrapped text can be taller than the layout's estimate: keep room (as PlatformCard).
    min-height: wcol.preferred-height + 16px;
    in property <bool> wifi-busy;
    in property <image> qr-image;
    in property <bool> qr-on;
    in property <string> qr-status;
    callback wifi-connect(string);
    callback wifi-pair(string, string);
    callback wifi-qr();
    callback wifi-qr-cancel();
    property <bool> code-open: false;
    wcol := VerticalLayout {
        padding: 14px;
        spacing: 10px;
        Text {
            text: I18n.t("Already on the cable? Press the Wi-Fi button next to the phone's name, done. Without a cable (Android 11+):");
            font-size: 11.5px;
            color: Theme.text-2;
            wrap: word-wrap;
        }
        if !root.qr-on: VerticalLayout {
            spacing: 6px;
            Text { text: I18n.t("Option 1 · Scan a QR code (easiest)"); font-size: 12.5px; font-weight: 650; color: Theme.text; }
            StepRow { text: "1.  " + I18n.t("The phone and the PC are on the same Wi-Fi."); }
            StepRow { text: "2.  " + I18n.t("On the phone: Settings › Developer options › Wireless debugging › turn it on."); }
            StepRow { text: "3.  " + I18n.t("Press the button below, then on the phone tap \"Pair device with QR code\" and scan."); }
            HorizontalLayout {
                alignment: start;
                GlassButton {
                    primary: true;
                    icon: "\u{ED14}";
                    label: I18n.t("Show QR code");
                    enabled: !root.wifi-busy;
                    tip: I18n.t("Show a QR code to scan on the phone");
                    clicked => { root.wifi-qr(); }
                }
            }
        }
        if root.qr-on: VerticalLayout {
            spacing: 8px;
            alignment: start;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 196px;
                    height: 196px;
                    border-radius: 12px;
                    background: white;
                    Image {
                        source: root.qr-image;
                        width: 180px;
                        height: 180px;
                        image-rendering: pixelated;
                    }
                }
            }
            Text {
                text: I18n.t("On the phone: Wireless debugging › \"Pair device with QR code\", then scan this code.");
                font-size: 11.5px;
                color: Theme.text-2;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            BusyBar { }
            Text {
                text: root.qr-status;
                font-size: 11.5px;
                color: Theme.accent;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                GlassButton {
                    icon: "\u{E711}";
                    label: I18n.t("Cancel");
                    clicked => { root.wifi-qr-cancel(); }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }
        HorizontalLayout {
            spacing: 8px;
            Text { text: I18n.t("Option 2 · Pairing code or IP address"); font-size: 12.5px; font-weight: 650; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
            GlassButton {
                label: root.code-open ? I18n.t("Hide") : I18n.t("Show");
                clicked => { root.code-open = !root.code-open; }
            }
        }
        if root.code-open: VerticalLayout {
            spacing: 6px;
            StepRow { text: "1.  " + I18n.t("In Wireless debugging, tap \"Pair device with pairing code\"."); }
            StepRow { text: "2.  " + I18n.t("Enter the IP:port and the 6-digit code shown in that window, press Pair."); }
            StepRow { text: "3.  " + I18n.t("Enter the IP:port from the main Wireless debugging screen (a different port), press Connect. Paired before? Go straight to step 3."); }
            HorizontalLayout {
                spacing: 8px;
                addr := Field {
                    placeholder: I18n.t("IP:port, e.g. 192.168.1.20:37099");
                    accepted => { if !root.wifi-busy { root.wifi-connect(self.text); } }
                }
                code := Field {
                    horizontal-stretch: 0;
                    width: 96px;
                    placeholder: I18n.t("6-digit code");
                    input-type: InputType.number;
                    accepted => { if !root.wifi-busy { root.wifi-pair(addr.text, self.text); } }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                GlassButton {
                    icon: "\u{E8D7}";
                    label: "Pair";
                    enabled: !root.wifi-busy && code.text != "";
                    tip: I18n.t("Step 2: pair once with the code from the phone");
                    clicked => { root.wifi-pair(addr.text, code.text); }
                }
                GlassButton {
                    primary: true;
                    icon: "\u{E71B}";
                    label: I18n.t("Connect");
                    enabled: !root.wifi-busy && addr.text != "";
                    tip: I18n.t("Step 3: connect to this address (adb connect)");
                    clicked => { root.wifi-connect(addr.text); }
                }
            }
        }
    }
}

component AndroidHome inherits Rectangle {
    in property <string> status;
    in property <[AndroidRow]> devices;
    // "idle", "connecting", "error" (the workspace hides while streaming).
    in property <string> phase: "idle";
    in property <string> message;
    in-out property <Prefs> prefs;
    in property <bool> hevc-ok;
    callback prefs-changed(Prefs);
    callback back();
    callback start-device(int);
    callback start-device-via(int, string);
    // The row Start uses (-1: none picked) and a click on a row.
    in property <int> selected: -1;
    callback pick-device(int);
    // Phase A6: Android over Wi-Fi.
    in property <bool> wifi-busy;
    // Current Wi-Fi step while busy ("Reading the phone's Wi-Fi address…").
    in property <string> wifi-status;
    callback wifi-device(int);
    callback wifi-connect(string);
    callback wifi-pair(string, string);
    // QR pairing: the image, a status line, and whether it runs.
    in property <image> qr-image;
    in property <bool> qr-on;
    in property <string> qr-status;
    callback wifi-qr();
    callback wifi-qr-cancel();
    property <bool> wifi-open: false;
    // adb is not bundled: ZenLink downloads Google's platform-tools on request.
    in property <bool> adb-missing;
    in property <float> adb-progress: -1; // 0..1 while downloading, -1 otherwise
    in property <string> adb-error;
    callback install-adb();
    Glass {
        width: min(parent.width - 32px, 460px);
        height: min(parent.height - 32px, acol.preferred-height + 2px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 20px;
        ScrollView {
            acol := VerticalLayout {
                padding: 18px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 11px;
                        background: @linear-gradient(135deg, #3ddc84 0%, #3ddc84.darker(0.35) 100%);
                        Icon { text: "\u{E70A}"; color: white; font-size: 17px; }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text { text: I18n.t("Android Smartphone / Tablet"); font-size: 15px; font-weight: 800; color: Theme.text; }
                        Text { text: root.status; font-size: 11.5px; color: Theme.text-2; wrap: word-wrap; }
                    }
                }
                if root.adb-missing: VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: I18n.t("Android needs adb, Google's official tool (about 8 MB). ZenLink downloads and installs it for you, once.");
                        font-size: 12px; color: Theme.text; wrap: word-wrap;
                    }
                    if root.adb-progress >= 0: Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.fill;
                        clip: true;
                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(root.adb-progress, 0, 1);
                            height: parent.height;
                            border-radius: 3px;
                            background: Theme.accent;
                            animate width { duration: 120ms; }
                        }
                    }
                    if root.adb-progress >= 0: Text {
                        text: I18n.t("Downloading adb… ") + round(root.adb-progress * 100) + "%";
                        font-size: 11px; color: Theme.text-2;
                    }
                    if root.adb-error != "": Text { text: root.adb-error; font-size: 11px; color: Theme.warn; wrap: word-wrap; }
                    if root.adb-progress < 0: HorizontalLayout {
                        alignment: start;
                        GlassButton {
                            primary: true;
                            icon: "\u{E896}";
                            label: I18n.t("Install adb");
                            tip: I18n.t("Download from dl.google.com, checked with SHA-256");
                            clicked => { root.install-adb(); }
                        }
                    }
                }
                for d[i] in root.devices: Rectangle {
                    border-radius: 12px;
                    background: d.selected ? (Theme.dark ? #ffffff14 : #ffffffd0) : rowTa.has-hover ? (Theme.dark ? #ffffff0c : #ffffffa0) : (Theme.dark ? #ffffff06 : #ffffff70);
                    border-width: 1px;
                    border-color: d.selected ? Theme.accent.with-alpha(0.7) : Theme.line;
                    animate background, border-color { duration: 160ms; }
                    rowTa := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.pick-device(i); }
                    }
                    HorizontalLayout {
                        padding: 10px;
                        padding-left: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: d.ok ? Theme.ok : Theme.warn; }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: d.title; font-size: 12.5px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
                            Text { text: d.sub; font-size: 11px; color: Theme.text-2; wrap: word-wrap; }
                        }
                        if d.wifi && root.phase != "connecting": VerticalLayout {
                            alignment: center;
                            GlassButton {
                                icon: "\u{E701}";
                                label: "Wi-Fi";
                                enabled: !root.wifi-busy;
                                tip: I18n.t("Switch to Wi-Fi: once connected, you can unplug the cable");
                                clicked => { root.wifi-device(i); }
                            }
                        }
                        if d.selected: VerticalLayout {
                            alignment: center;
                            Text { text: "\u{E73E}"; font-family: Theme.icons; font-size: 12px; color: Theme.accent; }
                        }
                    }
                }
                // One Start for the picked device; a phone on USB and Wi-Fi at once
                // gets one Start per link.
                if root.phase != "connecting": HorizontalLayout {
                    alignment: end;
                    spacing: 6px;
                    if root.selected >= 0 && root.devices[root.selected].both: GlassButton {
                        primary: true;
                        icon: "\u{E768}";
                        label: "USB";
                        tip: I18n.t("Start over the USB cable (most stable, lowest delay)");
                        clicked => { root.start-device-via(root.selected, "usb"); }
                    }
                    if root.selected >= 0 && root.devices[root.selected].both: GlassButton {
                        primary: true;
                        icon: "\u{E701}";
                        label: "Wi-Fi";
                        tip: I18n.t("Start over Wi-Fi (you can unplug the cable)");
                        clicked => { root.start-device-via(root.selected, "wifi"); }
                    }
                    if root.selected < 0 || !root.devices[root.selected].both: GlassButton {
                        primary: root.selected >= 0 && root.devices[root.selected].ok;
                        icon: "\u{E768}";
                        label: I18n.t("Start");
                        tip: I18n.t("Start mirroring the picked device");
                        clicked => { root.start-device(root.selected); }
                    }
                }
                if root.phase == "connecting": Text {
                    text: I18n.t("Connecting… the phone starts the scrcpy server.");
                    font-size: 11.5px;
                    color: Theme.accent;
                    wrap: word-wrap;
                }
                if root.message != "": Text {
                    text: root.message;
                    font-size: 11.5px;
                    color: Theme.warn;
                    wrap: word-wrap;
                }
                // Wi-Fi work in progress (switch to Wi-Fi, pair, connect):
                // a moving bar and the current step, so it never looks stuck.
                if root.wifi-busy: VerticalLayout {
                    spacing: 6px;
                    BusyBar { }
                    Text {
                        text: root.wifi-status != "" ? root.wifi-status : I18n.t("Working…");
                        font-size: 11.5px;
                        color: Theme.accent;
                        wrap: word-wrap;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    GlassButton {
                        icon: "\u{E701}";
                        label: I18n.t("Connect over Wi-Fi");
                        active: root.wifi-open;
                        tip: I18n.t("Scan a QR code, a pairing code or an IP:port address");
                        clicked => { root.wifi-open = !root.wifi-open; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.wifi-open || root.qr-on: AndroidWifiCard {
                    wifi-busy: root.wifi-busy;
                    qr-image: root.qr-image;
                    qr-on: root.qr-on;
                    qr-status: root.qr-status;
                    wifi-connect(a) => { root.wifi-connect(a); }
                    wifi-pair(a, c) => { root.wifi-pair(a, c); }
                    wifi-qr => { root.wifi-qr(); }
                    wifi-qr-cancel => { root.wifi-qr-cancel(); }
                }
                AndroidVideoCard {
                    prefs: root.prefs;
                    hevc-ok: root.hevc-ok;
                    changed(p) => { root.prefs-changed(p); }
                }
                FlowStep {
                    title: I18n.t("Turn on USB debugging");
                    sub: I18n.t("Settings › About phone › tap Build number 7×, then Developer options › USB debugging.");
                    state: "todo";
                }
                FlowStep {
                    title: I18n.t("Plug in the USB cable");
                    sub: I18n.t("Use a data cable, not a charge-only cable.");
                    state: "todo";
                }
                FlowStep {
                    title: I18n.t("Allow it on the phone");
                    sub: I18n.t("Tap Allow on the Allow USB debugging prompt.");
                    state: "todo";
                    last: true;
                }
                Text {
                    text: I18n.t("Beta: picture, sound (Android 11+) and control from the PC. No driver is installed or changed.");
                    font-size: 11px;
                    color: Theme.text-3;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    GlassButton { icon: "\u{E72B}"; label: I18n.t("Change device type"); clicked => { root.back(); } }
                }
            }
        }
    }
}

// "Connect a device" (v2.6): how to add a phone, inside the stage. A phone
// that connects shows up in the device menu on its own.
// Device and link marks as 24x24 SVG paths (Material Design Icons, Apache-2.0):
// the real shapes read better than generic font glyphs.
global Glyphs {
    out property <string> android: "M17.6 9.48l1.84-3.18c.16-.31.04-.69-.26-.85a.637.637 0 0 0-.83.22l-1.88 3.24a11.463 11.463 0 0 0-8.94 0L5.65 5.67a.643.643 0 0 0-.87-.2c-.28.18-.37.54-.22.83L6.4 9.48A10.78 10.78 0 0 0 1 18h22a10.78 10.78 0 0 0-5.4-8.52zM7 15.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5zm10 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5z";
    out property <string> apple: "M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.34-1.04 3.19-.69.85-1.83 1.52-2.95 1.43-.15-1.15.41-2.35 1.05-3.12z";
    out property <string> usb: "M15 7v4h1v2h-3V5h2l-3-4-3 4h2v8H8v-2.07c.7-.37 1.2-1.08 1.2-1.93 0-1.22-.99-2.2-2.2-2.2-1.22 0-2.2.98-2.2 2.2 0 .85.5 1.56 1.2 1.93V13a2 2 0 0 0 2 2h3v3.05c-.71.36-1.2 1.1-1.2 1.95a2.2 2.2 0 0 0 2.2 2.2 2.2 2.2 0 0 0 2.2-2.2c0-.85-.49-1.59-1.2-1.95V15h3a2 2 0 0 0 2-2v-2h1V7h-4z";
    out property <string> wifi: "M12 21l3.6-4.8c-1-.75-2.25-1.2-3.6-1.2s-2.6.45-3.6 1.2L12 21m0-18C7.95 3 4.21 4.34 1.2 6.6L3 9c2.5-1.88 5.62-3 9-3s6.5 1.12 9 3l1.8-2.4C19.79 4.34 16.05 3 12 3m0 6c-2.7 0-5.19.89-7.2 2.4l1.8 2.4c1.5-1.13 3.37-1.8 5.4-1.8s3.9.67 5.4 1.8l1.8-2.4C17.19 9.89 14.7 9 12 9z";
}

// A small selectable tile: gradient icon, title and one line (add-device page).
component ChoiceTile inherits Rectangle {
    in property <string> icon;
    in property <string> glyph; // SVG path (24x24) drawn instead of the font icon

    in property <string> title;
    in property <string> sub;
    in property <color> tint;
    in property <bool> selected;
    callback pick();
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.pick(); }
    min-height: tcol.preferred-height;
    border-radius: 14px;
    background: selected ? tint.with-alpha(Theme.dark ? 0.16 : 0.12) : ta.has-hover ? Theme.hover.with-alpha(Theme.dark ? 0.10 : 0.5) : (Theme.dark ? #ffffff08 : #ffffff80);
    border-width: selected ? 1.5px : 1px;
    border-color: selected ? tint : Theme.line;
    animate background, border-color { duration: 200ms; easing: ease-out; }
    transform-scale-x: ta.pressed ? 98% : 100%;
    transform-scale-y: ta.pressed ? 98% : 100%;
    animate transform-scale-x, transform-scale-y { duration: ta.pressed ? 120ms : 300ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.pick(); } }
    tcol := HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        Rectangle {
            width: 34px;
            height: 34px;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            background: @linear-gradient(135deg, root.tint 0%, root.tint.darker(0.35) 100%);
            opacity: root.selected ? 1 : 0.75;
            if root.glyph == "": Icon { text: root.icon; color: white; font-size: 16px; }
            if root.glyph != "": Path { width: 19px; height: 19px; viewbox-width: 24; viewbox-height: 24; commands: root.glyph; fill: white; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.title; font-size: 13px; font-weight: 700; color: Theme.text; overflow: elide; }
            Text { text: root.sub; font-size: 10.5px; color: Theme.text-2; overflow: elide; }
        }
    }
}

component AddDevice inherits Rectangle {
    in-out property <string> kind: "android";
    // Android: "usb" | "wifi"
    in-out property <string> way: "usb";
    in-out property <Prefs> prefs;
    callback prefs-changed(Prefs);
    in property <bool> adb-missing;
    in property <bool> wifi-busy;
    in property <string> wifi-status;
    in property <image> qr-image;
    in property <bool> qr-on;
    in property <string> qr-status;
    callback install-adb();
    callback wifi-connect(string);
    callback wifi-pair(string, string);
    callback wifi-qr();
    callback wifi-qr-cancel();
    callback close();
    TouchArea { }
    Glass {
        // Solid enough to read over any background (the plain glass looked washed out).
        strong: true;
        background: Theme.dark ? #1c1c1ef2 : #f6f6f9f2;
        width: min(parent.width - 32px, 480px);
        height: min(parent.height - 32px, col.preferred-height + 2px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 20px;
        sv := ScrollView {
            col := VerticalLayout {
                // A known width lets wrapped text report its real height (else the card ends short).
                width: sv.visible-width;
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 11px;
                        background: @linear-gradient(135deg, Theme.accent 0%, Theme.accent.darker(0.35) 100%);
                        Icon { text: "\u{E710}"; color: white; font-size: 17px; }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text { text: I18n.t("Connect a new device"); font-size: 15px; font-weight: 800; color: Theme.text; }
                        Text { text: I18n.t("Once connected, the device shows up in the menu on the left."); font-size: 11.5px; color: Theme.text-2; wrap: word-wrap; }
                    }
                    VerticalLayout { alignment: start; GlassButton { icon: "\u{E711}"; tip: I18n.t("Close"); clicked => { root.close(); } } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Bahasa / Language"; font-size: 11.5px; color: Theme.text-2; vertical-alignment: center; horizontal-stretch: 1; }
                    LangPicker {
                        width: 190px;
                        value: root.prefs.lang;
                        changed(v) => { root.prefs.lang = v; root.prefs-changed(root.prefs); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    ChoiceTile {
                        horizontal-stretch: 1;
                        icon: "\u{E70A}";
                        glyph: Glyphs.android;
                        tint: #3ddc84;
                        title: "Android";
                        sub: I18n.t("Phones & tablets, any brand");
                        selected: root.kind == "android";
                        pick => { root.kind = "android"; }
                    }
                    ChoiceTile {
                        horizontal-stretch: 1;
                        icon: "\u{E8EA}";
                        glyph: Glyphs.apple;
                        tint: #5ac8fa;
                        title: "iPhone / iPad";
                        sub: I18n.t("Cable, then Wi-Fi");
                        selected: root.kind == "apple";
                        pick => { root.kind = "apple"; }
                    }
                }
                if root.kind == "android": VerticalLayout {
                    spacing: 10px;
                    if root.adb-missing: HorizontalLayout {
                        spacing: 8px;
                        Text { text: I18n.t("Android needs adb (about 8 MB, once)."); font-size: 12px; color: Theme.text; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                        GlassButton { primary: true; icon: "\u{E896}"; label: I18n.t("Install adb"); clicked => { root.install-adb(); } }
                    }
                    // One way at a time keeps the card short at normal window size.
                    HorizontalLayout {
                        spacing: 8px;
                        ChoiceTile {
                            horizontal-stretch: 1;
                            icon: "\u{E88E}";
                            glyph: Glyphs.usb;
                            tint: #f472b6;
                            title: I18n.t("USB cable");
                            sub: I18n.t("Most stable");
                            selected: root.way == "usb";
                            pick => { root.way = "usb"; }
                        }
                        ChoiceTile {
                            horizontal-stretch: 1;
                            icon: "\u{E701}";
                            glyph: Glyphs.wifi;
                            tint: #a78bfa;
                            title: "Wi-Fi";
                            sub: I18n.t("No cable · Android 11+");
                            selected: root.way == "wifi";
                            pick => { root.way = "wifi"; }
                        }
                    }
                    if root.way == "usb": FlowStep {
                        title: I18n.t("Turn on USB debugging");
                        sub: I18n.t("Settings › About phone › tap Build number 7×, then Developer options › USB debugging.");
                        state: "todo";
                    }
                    if root.way == "usb": FlowStep {
                        title: I18n.t("Plug in a data cable");
                        sub: I18n.t("Then tap Allow on the phone. It shows up in the menu right away.");
                        state: "todo";
                        last: true;
                    }
                    if root.way == "wifi" && root.wifi-busy: VerticalLayout {
                        spacing: 6px;
                        BusyBar { }
                        Text { text: root.wifi-status != "" ? root.wifi-status : I18n.t("Working…"); font-size: 11.5px; color: Theme.accent; wrap: word-wrap; }
                    }
                    if root.way == "wifi": AndroidWifiCard {
                        wifi-busy: root.wifi-busy;
                        qr-image: root.qr-image;
                        qr-on: root.qr-on;
                        qr-status: root.qr-status;
                        wifi-connect(a) => { root.wifi-connect(a); }
                        wifi-pair(a, c) => { root.wifi-pair(a, c); }
                        wifi-qr => { root.wifi-qr(); }
                        wifi-qr-cancel => { root.wifi-qr-cancel(); }
                    }
                }
                if root.kind == "apple": VerticalLayout {
                    spacing: 10px;
                    FlowStep {
                        title: I18n.t("Plug the cable into the PC");
                        sub: I18n.t("Unlock the iPhone/iPad first.");
                        state: "todo";
                    }
                    FlowStep {
                        title: I18n.t("Tap Trust, enter the passcode");
                        sub: I18n.t("The device shows up in the menu on the left. Pick it to start.");
                        state: "todo";
                    }
                    FlowStep {
                        title: I18n.t("Wi-Fi (optional)");
                        sub: I18n.t("After one cable setup, the device on the same Wi-Fi shows up without the cable.");
                        state: "todo";
                        last: true;
                    }
                }
            }
        }
    }
}

// One line of the shortcut list: key cap(s) and what they do.
component KeyRow inherits HorizontalLayout {
    in property <string> keys;
    in property <string> text;
    spacing: 10px;
    Rectangle {
        width: 132px;
        HorizontalLayout {
            alignment: start;
            Rectangle {
                height: 22px;
                width: kt.preferred-width + 14px;
                border-radius: 6px;
                background: Theme.dark ? #ffffff14 : #0000000d;
                border-width: 1px;
                border-color: Theme.rim;
                kt := Text { text: root.keys; font-size: 11px; font-weight: 600; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
    Text { text: root.text; font-size: 11.5px; color: Theme.text-2; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
}

component SettingsPanel inherits Glass {
    in-out property <Prefs> prefs;
    in property <string> driver-text;
    in property <string> connection;
    // Cable or Wi-Fi, for both Apple Driver and ZenLink Studio.
    in property <string> link: "wired";
    in property <string> mode;
    in property <string> screen: "apple";
    // Driver changes that fit the device (each asks for confirmation).
    in property <bool> drv-restore;
    in property <bool> drv-bind;
    in property <bool> drv-filter;
    // Updates (v2.5.1): status line, the offered version ("" = none),
    // download progress 0..1 (-1 = not downloading).
    in property <string> upd-status;
    in property <string> upd-version;
    in property <string> upd-notes;
    in property <bool> upd-switch;
    in property <bool> upd-busy;
    in property <float> upd-progress: -1;
    in property <string> upd-channel-own: "beta";
    callback update-action(string);
    callback set-link(string);
    // ZenLink Studio (USB Direct / AirPlay): picture and sound only. Touch,
    // keyboard, buttons, device shortcuts and auto unlock need Apple Driver mode.
    property <bool> studio: root.screen != "android" && root.mode == "usbdirect";
    // Auto unlock (Apple Driver mode): a passcode is saved on this PC.
    in property <bool> passcode-set;
    callback save-passcode(string);
    in property <string> stats-full;
    in property <bool> hevc-ok;
    callback changed(Prefs);
    callback close();
    callback driver-action(string);
    border-radius: 20px;
    VerticalLayout {
        HorizontalLayout {
            padding: 12px;
            padding-bottom: 4px;
            spacing: 10px;
            Image { source: @image-url("../../../ZenshiroDev/resources/assets/logo-256.png"); width: 30px; height: 30px; }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: "ZenLink"; font-size: 15px; font-weight: 800; color: Theme.text; }
                Text { text: I18n.t("Settings & controls"); font-size: 11px; color: Theme.accent; font-weight: 600; }
            }
            GlassButton { icon: "\u{E711}"; clicked => { root.close(); } }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 12px;
                padding-top: 6px;
                spacing: 10px;

                Card {
                    title: I18n.t("Appearance");
                    icon: "\u{E790}";
                    tint-a: #f472b6;
                    tint-b: #db2777;
                    info: I18n.t("Liquid Glass shows the real desktop behind the window. Thickness 0% = fully clear with no blur, higher = more frosted (Windows' own blur). Turn it off for a solid window with no extra GPU work.");
                    Seg {
                        options: ["light", "dark", "system"];
                        labels: [I18n.t("Light"), I18n.t("Dark"), I18n.t("System")];
                        value: prefs.theme;
                        changed(v) => { root.prefs.theme = v; root.changed(root.prefs); }
                    }
                    Row {
                        label: "Liquid Glass";
                        Toggle { checked: prefs.glass-on; toggled(v) => { root.prefs.glass-on = v; root.changed(root.prefs); } }
                    }
                    if prefs.glass-on: Row {
                        label: I18n.t("Glass thickness");
                        Text { text: round(prefs.glass) + "%" + (prefs.glass < 1 ? I18n.t(" · clear") : ""); font-size: 12px; color: Theme.text-2; vertical-alignment: center; }
                    }
                    if prefs.glass-on: GlassSlider {
                        step: 5;
                        value: prefs.glass;
                        changed(v) => { root.prefs.glass = v; root.changed(root.prefs); }
                    }
                    Row {
                        label: I18n.t("Animated background");
                        Toggle { checked: prefs.dots; toggled(v) => { root.prefs.dots = v; root.changed(root.prefs); } }
                    }
                    Row {
                        label: I18n.t("Language");
                        LangPicker {
                            width: 150px;
                            value: prefs.lang;
                            changed(v) => { root.prefs.lang = v; root.changed(root.prefs); }
                        }
                    }
                }

                Card {
                    title: I18n.t("Display & aspect");
                    icon: "\u{E7F4}";
                    tint-a: #a78bfa;
                    tint-b: #7c3aed;
                    info: I18n.t("Auto-Fit shows the whole device screen. Edge-to-Edge fills the area and crops the sides. The window follows the device's size and orientation (portrait / landscape).");
                    Seg {
                        options: ["contain", "cover", "fill"];
                        labels: ["Auto-Fit", "Edge-to-Edge", "Stretch"];
                        value: prefs.fit;
                        changed(v) => { root.prefs.fit = v; root.changed(root.prefs); }
                    }
                    Row {
                        label: I18n.t("Window follows the screen");
                        hint: I18n.t("Portrait / landscape automatically");
                        Toggle { checked: prefs.fit-window; toggled(v) => { root.prefs.fit-window = v; root.changed(root.prefs); } }
                    }
                    Text { text: I18n.t("Rotation"); font-size: 12.5px; color: Theme.text; }
                    Seg {
                        options: ["auto", "0", "90", "180", "270"];
                        labels: ["Auto", "0°", "90°", "180°", "270°"];
                        value: prefs.rotation;
                        changed(v) => { root.prefs.rotation = v; root.changed(root.prefs); }
                    }
                }


                Card {
                    title: I18n.t("Record / stream in OBS");
                    icon: "\u{E714}";
                    tint-a: #f87171;
                    tint-b: #dc2626;
                    info: I18n.t("Game Capture takes the picture straight from the GPU: sharp, no window frame, and it keeps working when ZenLink is behind other windows. Window Capture also works, but it picks up the window frame too.");
                    Text {
                        text: I18n.t("In OBS, add a Game Capture source → Mode: capture specific window → pick [ZenLink.exe]: ZenLink. Then select it and press Ctrl+F (Fit to screen): portrait / landscape stays centred automatically.");
                        font-size: 11.5px;
                        color: Theme.text-2;
                        wrap: word-wrap;
                    }
                }

                Card {
                    title: I18n.t("Device audio → PC");
                    icon: "\u{E767}";
                    tint-a: #fb923c;
                    tint-b: #ea580c;
                    info: I18n.t("Sound plays through WASAPI on this PC. Lip sync holds the picture a little so it matches the sound. Low buffer is tighter, high rides out hiccups.");
                    Seg {
                        options: ["pc", "device", "both"];
                        labels: ["Windows", I18n.t("Device"), I18n.t("Both")];
                        value: prefs.audio-out;
                        changed(v) => { root.prefs.audio-out = v; root.changed(root.prefs); }
                    }
                    Text {
                        text: prefs.audio-out == "pc"
                            ? I18n.t("Sound on Windows only; the device stays silent.")
                            : prefs.audio-out == "device"
                            ? I18n.t("Sound on the device only; Windows stays silent.")
                            : root.studio
                            ? I18n.t("ZenLink Studio over the cable can't play in both places: the sound plays on Windows.")
                            : root.screen == "android"
                            ? I18n.t("Sound on Windows and the phone (Android 13+; older phones: Windows only).")
                            : I18n.t("Sound on Windows and on the device.");
                        font-size: 11px;
                        color: Theme.text-2;
                        wrap: word-wrap;
                    }
                    Row {
                        label: I18n.t("PC volume");
                        Text { text: round(prefs.volume) + "%"; font-size: 12px; color: Theme.text-2; vertical-alignment: center; }
                    }
                    GlassSlider { value: prefs.volume; changed(v) => { root.prefs.volume = v; root.changed(root.prefs); } }
                    Row {
                        label: "Lip sync";
                        Toggle { checked: prefs.lip-sync; toggled(v) => { root.prefs.lip-sync = v; root.changed(root.prefs); } }
                    }
                    Seg {
                        options: ["low", "normal", "high"];
                        labels: [I18n.t("Low"), "Normal", I18n.t("High")];
                        value: prefs.audio-buffer;
                        changed(v) => { root.prefs.audio-buffer = v; root.changed(root.prefs); }
                    }
                }

                if !root.studio: Card {
                    title: I18n.t("Control");
                    icon: "\u{E765}";
                    tint-a: #38bdf8;
                    tint-b: #0284c7;
                    info: root.screen == "android"
                        ? I18n.t("Click = tap, drag = swipe, scroll = scroll on the phone. Right click = Back, middle click = Home. Click the picture first so the PC keyboard types on the phone.")
                        : I18n.t("Click and drag = touch. Mouse Back button = swipe back. The PC keyboard works as a hardware keyboard in Apple Driver mode; click the picture first.");
                    Row { label: I18n.t("Touch with the mouse"); Toggle { checked: prefs.touch; toggled(v) => { root.prefs.touch = v; root.changed(root.prefs); } } }
                    Row { label: I18n.t("PC keyboard to the device"); Toggle { checked: prefs.keyboard; toggled(v) => { root.prefs.keyboard = v; root.changed(root.prefs); } } }
                    if root.screen != "android": Row { label: I18n.t("Gestures (scroll, mouse Back button)"); Toggle { checked: prefs.gestures; toggled(v) => { root.prefs.gestures = v; root.changed(root.prefs); } } }
                }

                Card {
                    title: "Keyboard shortcuts";
                    icon: "\u{E92E}";
                    tint-a: #a78bfa;
                    tint-b: #7c3aed;
                    info: I18n.t("While the PC keyboard types on the device, single keys (Space, M) go to the device; Alt and Ctrl shortcuts stay with ZenLink.");
                    KeyRow { keys: "Alt + M"; text: I18n.t("Sound on the PC on / off"); }
                    KeyRow { keys: "F11 · Esc"; text: I18n.t("Full screen / leave"); }
                    KeyRow { keys: "Ctrl + ,"; text: I18n.t("Open / close Settings"); }
                    KeyRow { keys: "Alt + H"; text: I18n.t("Rotate the view (Auto, 90°, 180°, 270°, 0°)"); }
                    if !root.studio: KeyRow { keys: "Alt + ←"; text: "Back"; }
                    KeyRow { keys: "Alt + C"; text: I18n.t("Copy the text on the device screen to the PC (OCR)"); }
                    KeyRow { keys: "Alt + R"; text: I18n.t("Clear the copied-text history"); }
                    if !root.studio: KeyRow { keys: "Alt + L"; text: root.screen == "android" ? I18n.t("Power button (lock / wake the screen)") : I18n.t("Lock the device"); }
                    if root.screen == "android": KeyRow { keys: "Ctrl + V"; text: I18n.t("Paste the PC clipboard on the phone"); }
                    if root.screen == "android": KeyRow { keys: "Ctrl + C / X"; text: I18n.t("Copy / cut on the phone, also to the PC clipboard"); }
                    if root.screen == "android": KeyRow { keys: "Ctrl + A / Z"; text: I18n.t("Select all, undo on the phone"); }
                    if !root.studio: KeyRow { keys: "Ctrl + wheel"; text: I18n.t("Pinch zoom on the device (touchpad pinch too)"); }
                    if !root.studio: KeyRow { keys: "Alt + N"; text: root.screen == "android" ? "Notifications" : I18n.t("Notification Center (open / close)"); }
                    if !root.studio: KeyRow { keys: "Alt + Q"; text: root.screen == "android" ? "Quick Settings" : I18n.t("Control Center (open / close)"); }
                    if root.screen == "android": KeyRow { keys: "Alt + S"; text: "Recent Apps"; }
                    if root.screen == "android": KeyRow { keys: "Alt + ↑ / ↓"; text: I18n.t("Phone volume up / down"); }
                    if root.screen != "android" && !root.studio: KeyRow { keys: "Alt + U"; text: I18n.t("Wake & unlock (saved passcode)"); }
                    if root.screen != "android" && !root.studio: KeyRow { keys: "Alt + D"; text: I18n.t("Stealth dim: device screen to 0% / restore"); }
                    if root.screen != "android" && !root.studio: KeyRow { keys: "Ctrl + V"; text: I18n.t("Type the PC clipboard text on the device"); }
                    if root.screen != "android" && !root.studio: KeyRow { keys: "Ctrl + Shift + V"; text: I18n.t("Paste the device's own clipboard"); }
                    if root.screen != "android" && !root.studio: KeyRow { keys: "Ctrl + K"; text: I18n.t("Show / hide the on-screen keyboard"); }
                    if root.screen != "android" && !root.studio: KeyRow { keys: "Ctrl + C / X / A / Z"; text: I18n.t("Copy, cut, select all, undo in iOS"); }
                    if root.screen != "android": Text {
                        text: root.studio ? I18n.t("ZenLink Studio is picture and sound only: device control and its shortcuts are in Apple Driver mode.")
                            : I18n.t("Apple device shortcuts work in Apple Driver mode while mirroring.");
                        font-size: 11px;
                        color: Theme.text-3;
                        wrap: word-wrap;
                    }
                }

                Card {
                    title: I18n.t("Device type");
                    icon: "\u{E8EA}";
                    tint-a: #5ac8fa;
                    tint-b: #0a84ff;
                    info: I18n.t("Choose iPhone / iPad or Android. A running session is stopped safely first. Apple and Android settings are kept separately.");
                    Text { text: root.screen == "android" ? I18n.t("Android Smartphone / Tablet") : "iPhone / iPad"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                    Row {
                        label: I18n.t("Remember device type");
                        Toggle { checked: prefs.remember-platform; toggled(v) => { root.prefs.remember-platform = v; root.changed(root.prefs); } }
                    }
                    HorizontalLayout {
                        alignment: start;
                        GlassButton { icon: "\u{E72B}"; label: I18n.t("Change device type"); clicked => { root.driver-action("platform"); } }
                    }
                }

                if root.screen == "android": AndroidVideoCard {
                    prefs: root.prefs;
                    hevc-ok: root.hevc-ok;
                    changed(p) => { root.changed(p); }
                }

                if root.screen != "android" && !root.studio: Card {
                    title: I18n.t("Auto unlock");
                    icon: "\u{E72E}";
                    tint-a: #a78bfa;
                    tint-b: #7c3aed;
                    info: I18n.t("Apple Driver mode only (not ZenLink Studio). ZenLink wakes the iPhone/iPad, swipes up and types your passcode or password. It is stored encrypted (Windows DPAPI) for this Windows account only and never sent anywhere. Alt+U unlocks at any time.");
                    Text {
                        text: root.passcode-set ? I18n.t("A passcode is saved on this PC.") : I18n.t("No passcode saved yet.");
                        font-size: 12.5px;
                        font-weight: 600;
                        color: root.passcode-set ? Theme.ok : Theme.text-2;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        pc := Field {
                            placeholder: I18n.t("Device passcode or password");
                            input-type: InputType.password;
                            accepted => { root.save-passcode(self.text); self.text = ""; }
                        }
                        GlassButton {
                            primary: true;
                            label: I18n.t("Save");
                            enabled: pc.text != "";
                            clicked => { root.save-passcode(pc.text); pc.text = ""; }
                        }
                        if root.passcode-set: GlassButton {
                            label: I18n.t("Remove");
                            clicked => { root.save-passcode(""); }
                        }
                    }
                    Row {
                        label: I18n.t("Unlock when mirroring starts");
                        hint: I18n.t("Also Alt+U at any time");
                        Toggle { checked: prefs.auto-unlock; toggled(v) => { root.prefs.auto-unlock = v; root.changed(root.prefs); } }
                    }
                    Row {
                        label: I18n.t("Unlock again when the screen locks");
                        hint: I18n.t("Apple Driver mode, uses the saved passcode");
                        Toggle { checked: prefs.unlock-on-lock; toggled(v) => { root.prefs.unlock-on-lock = v; root.changed(root.prefs); } }
                    }
                    if prefs.unlock-on-lock: Row {
                        label: I18n.t("Limit automatic unlocks");
                        hint: I18n.t("At most 3 times in 30 seconds, so a wrong passcode cannot repeat");
                        Toggle { checked: prefs.unlock-limit; toggled(v) => { root.prefs.unlock-limit = v; root.changed(root.prefs); } }
                    }
                }

                if root.screen != "android": Card {
                    title: I18n.t("Connection & driver");
                    icon: "\u{E88E}";
                    tint-a: #34d399;
                    tint-b: #059669;
                    info: I18n.t("Apple Driver uses Apple's own driver. ZenLink Studio uses libusb0 for high bitrate. Driver changes always ask for confirmation and administrator approval.");
                    Text { text: connection; font-size: 12.5px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
                    Text { text: driver-text; font-size: 11.5px; color: Theme.text-2; wrap: word-wrap; }
                    Row {
                        label: I18n.t("Connection");
                        Seg {
                            width: 170px;
                            options: ["wired", "wireless"];
                            labels: [I18n.t("Wired (USB)"), "Wi-Fi"];
                            value: root.link;
                            changed(v) => { root.set-link(v); }
                        }
                    }
                    Text {
                        text: root.mode == "usbdirect"
                            ? (root.link == "wireless" ? I18n.t("Wi-Fi: pick ZenLinkStudio in Screen Mirroring on the device.") : I18n.t("Wired: through the libusb0 driver, high bitrate."))
                            : (root.link == "wireless" ? I18n.t("Wi-Fi: press Set up Wi-Fi once with the cable in. A plugged-in device still works over the cable.") : I18n.t("Wired: through Apple's driver."));
                        font-size: 11px;
                        color: Theme.text-3;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        GlassButton { label: I18n.t("Change mode"); tip: I18n.t("Choose Apple Driver or ZenLink Studio"); clicked => { root.driver-action("mode"); } }
                        GlassButton { label: I18n.t("Check drivers"); clicked => { root.driver-action("refresh"); } }
                        if !root.studio: GlassButton { label: I18n.t("Set up Wi-Fi"); clicked => { root.driver-action("wifi"); } }
                    }
                    if root.drv-filter || (root.drv-restore && !root.studio) || (root.drv-bind && root.studio): HorizontalLayout {
                        spacing: 6px;
                        if root.drv-filter: GlassButton { primary: true; label: I18n.t("Remove libusb0 filter"); clicked => { root.driver-action("removefilter"); } }
                        if root.drv-restore && !root.studio: GlassButton { label: I18n.t("Restore Apple driver"); clicked => { root.driver-action("restore"); } }
                        if root.drv-bind && root.studio: GlassButton { label: I18n.t("Install ZenLink Studio driver"); clicked => { root.driver-action("bind"); } }
                    }
                }

                Card {
                    title: I18n.t("Updates");
                    icon: "\u{E895}";
                    tint-a: #34d399;
                    tint-b: #059669;
                    info: AppInfo.store ? I18n.t("This copy was installed from the Microsoft Store, so the Microsoft Store downloads and installs updates. Your settings stay.") : I18n.t("ZenLink downloads only after you press Update, straight from the official GitHub release, and checks the file's SHA-256 before running it. Your settings stay. Beta and Stable are separate apps: switching channel installs the other edition next to this one.");
                    Text { text: "ZenLink v" + AppInfo.version; font-size: 12.5px; font-weight: 700; color: Theme.text; }
                    if AppInfo.store: Text {
                        text: I18n.t("Microsoft Store edition: updates are installed by the Microsoft Store.");
                        font-size: 11.5px; color: Theme.text-2; wrap: word-wrap;
                    }
                    if AppInfo.store: GlassButton { label: I18n.t("Open in the Microsoft Store"); clicked => { root.update-action("store"); } }
                    if !AppInfo.store: Row { label: I18n.t("Check at start"); Toggle { checked: prefs.update-check; toggled(v) => { root.prefs.update-check = v; root.changed(root.prefs); } } }
                    if !AppInfo.store: Row {
                        label: I18n.t("Channel");
                        Seg {
                            width: 150px;
                            options: ["stable", "beta"];
                            labels: [I18n.t("Stable"), "Beta"];
                            value: prefs.update-channel == "" ? root.upd-channel-own : prefs.update-channel;
                            changed(v) => { root.prefs.update-channel = v == root.upd-channel-own ? "" : v; root.changed(root.prefs); root.update-action("check"); }
                        }
                    }
                    if root.upd-status != "": Text { text: root.upd-status; font-size: 11.5px; color: Theme.text-2; wrap: word-wrap; }
                    if root.upd-busy && root.upd-progress < 0: BusyBar { }
                    if root.upd-progress >= 0: Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.fill;
                        clip: true;
                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(root.upd-progress, 0, 1);
                            height: parent.height;
                            border-radius: 2px;
                            background: Theme.accent;
                            animate width { duration: 120ms; }
                        }
                    }
                    if root.upd-notes != "": Text { text: root.upd-notes; font-size: 11px; color: Theme.text-3; wrap: word-wrap; }
                    if root.upd-version != "": GlassButton {
                        primary: true;
                        enabled: !root.upd-busy;
                        label: (root.upd-switch ? I18n.t("Install v") : I18n.t("Update to v")) + root.upd-version;
                        clicked => { root.update-action("install"); }
                    }
                    if !AppInfo.store: HorizontalLayout {
                        spacing: 6px;
                        GlassButton { enabled: !root.upd-busy; label: I18n.t("Check for updates"); clicked => { root.update-action("check"); } }
                        if root.upd-version != "": GlassButton { label: I18n.t("Release notes"); clicked => { root.update-action("notes"); } }
                    }
                }

                Card {
                    title: I18n.t("Startup & closing");
                    icon: "\u{E7E8}";
                    tint-a: #60a5fa;
                    tint-b: #2563eb;
                    if !AppInfo.store: Row { label: I18n.t("Start with Windows"); Toggle { checked: prefs.start-with-windows; toggled(v) => { root.prefs.start-with-windows = v; root.changed(root.prefs); } } }
                    Text { text: I18n.t("When closing the window"); font-size: 12px; color: Theme.text; }
                    Seg {
                        options: ["ask", "tray", "quit"];
                        labels: [I18n.t("Ask every time"), I18n.t("Minimize to tray"), I18n.t("Quit")];
                        value: prefs.close-action;
                        changed(v) => { root.prefs.close-action = v; root.changed(root.prefs); }
                    }
                }

                Card {
                    title: I18n.t("Advanced");
                    icon: "\u{E713}";
                    tint-a: #a1a1aa;
                    tint-b: #52525b;
                    Row { label: I18n.t("Always on top"); Toggle { checked: prefs.on-top; toggled(v) => { root.prefs.on-top = v; root.changed(root.prefs); } } }
                    Text {
                        text: I18n.t("Ghost mode: press the key below while ZenLink is active. The window stays on top and clicks go to the app behind it (for example a trading chart). Press the key again, or click the tray icon, to use ZenLink again.");
                        font-size: 11.5px;
                        color: Theme.text-2;
                        wrap: word-wrap;
                    }
                    Seg {
                        options: ["F4", "F6", "F8", "F9"];
                        labels: ["F4", "F6", "F8", "F9"];
                        value: prefs.ghost-key;
                        changed(v) => { root.prefs.ghost-key = v; root.changed(root.prefs); }
                    }
                    Row {
                        label: I18n.t("Ghost mode opacity");
                        Text { text: round(max(20, prefs.ghost-opacity)) + "%"; font-size: 12px; color: Theme.text-2; vertical-alignment: center; }
                    }
                    GlassSlider {
                        step: 5;
                        value: prefs.ghost-opacity;
                        changed(v) => { root.prefs.ghost-opacity = max(20, v); root.changed(root.prefs); }
                    }
                    Row { label: I18n.t("Stats in the header"); Toggle { checked: prefs.stats; toggled(v) => { root.prefs.stats = v; root.changed(root.prefs); } } }
                }

                Card {
                    title: I18n.t("Stats (measured)");
                    icon: "\u{E9D9}";
                    tint-a: #facc15;
                    tint-b: #ca8a04;
                    info: I18n.t("All numbers are measured: decoded fps, presented fps, skipped frames (replaced by a newer frame before display), last frame decode time.");
                    Text { text: stats-full; font-size: 11.5px; color: Theme.text-2; font-family: "Cascadia Mono"; wrap: word-wrap; }
                }
                Card {
                    title: I18n.t("Edge crop (fine)");
                    icon: "\u{E7A8}";
                    tint-a: #94a3b8;
                    tint-b: #64748b;
                    info: I18n.t("Trim black bars or borders off the picture, in device pixels. Touches still land in the right place.");
                    for side[i] in [
                        { key: "t", en: "Top" },
                        { key: "b", en: "Bottom" },
                        { key: "l", en: "Left" },
                        { key: "r", en: "Right" },
                    ]: VerticalLayout {
                        spacing: 2px;
                        property <float> v: side.key == "t" ? prefs.crop-t : side.key == "b" ? prefs.crop-b : side.key == "l" ? prefs.crop-l : prefs.crop-r;
                        Row {
                            label: I18n.t(side.en);
                            Text { text: round(v) + " px"; font-size: 12px; color: Theme.text-2; vertical-alignment: center; }
                        }
                        GlassSlider {
                            maximum: 200;
                            step: 2;
                            value: v;
                            changed(x) => {
                                if side.key == "t" { root.prefs.crop-t = x; }
                                if side.key == "b" { root.prefs.crop-b = x; }
                                if side.key == "l" { root.prefs.crop-l = x; }
                                if side.key == "r" { root.prefs.crop-r = x; }
                                root.changed(root.prefs);
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        GlassButton {
                            label: I18n.t("Reset (0 px)");
                            clicked => {
                                root.prefs.crop-t = 0; root.prefs.crop-b = 0; root.prefs.crop-l = 0; root.prefs.crop-r = 0;
                                root.changed(root.prefs);
                            }
                        }
                    }
                }
                Card {
                    title: I18n.t("About & credits");
                    icon: "\u{E946}";
                    tint-a: #ec4899;
                    tint-b: #a855f7;
                    Text {
                        text: "ZenLink v" + AppInfo.version + "  ·  Next";
                        font-size: 12.5px;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    HorizontalLayout {
                        alignment: start;
                        GlassButton {
                            icon: "\u{E8B7}";
                            label: I18n.t("Open log folder");
                            tip: I18n.t("ZenLink logs for bug reports (%LOCALAPPDATA%\\ZenLink-Next\\logs)");
                            clicked => { root.driver-action("logs"); }
                        }
                    }
                    Text {
                        text: I18n.t("© 2026 Zenvy Zenshiro · GPL-3.0-or-later · no warranty.");
                        font-size: 11px;
                        color: Theme.text-2;
                        wrap: word-wrap;
                    }
                    Text {
                        text: I18n.t("Android: the scrcpy server (Genymobile & Romain Vimont, Apache-2.0) and Google's official adb (Android platform-tools, unmodified; NOTICE.txt in third_party). Apple: pymobiledevice3 (GPL-3.0), pane-iphone-mirror-windows (GPL-3.0), quicktime_video_hack (MIT), libusb-win32, UxPlay/playfair (GPL-3.0). AAC sound: FFmpeg (LGPL). Details: README and docs/THIRD_PARTY.md.");
                        font-size: 11px;
                        color: Theme.text-2;
                        wrap: word-wrap;
                    }
                    Text {
                        text: I18n.t("Android is a trademark of Google LLC. iPhone, iPad and AirPlay are trademarks of Apple Inc. ZenLink is not affiliated with Google or Apple.");
                        font-size: 10.5px;
                        color: Theme.text-3;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

// Android app launcher (v2.5.1): a grid like the phone's app drawer, over
// the picture while a phone is mirrored (dock › Apps). The picture leaves its
// rectangle open (main.rs, VideoView::set_holes).
component AppLauncher inherits Rectangle {
    in property <bool> open;
    in property <string> title;
    in property <string> status;
    in property <bool> busy;
    in property <[AppRow]> apps;
    // Android 10+: an app can also open in its own window.
    in property <bool> window-ok;
    in-out property <string> open-in: "phone";
    in property <bool> searchable: true;
    callback filter(string);
    callback launch(int, string);
    callback close();
    border-radius: 22px;
    background: Theme.dark ? #18181cf5 : #f6f6f9f5;
    border-width: 0.75px;
    border-color: Theme.dark ? #ffffff24 : #0000001c;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000055;
    clip: true;
    property <float> t: root.open ? 1 : 0;
    animate t { duration: 220ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
    opacity: self.t;
    visible: self.t > 0.01;
    // Swallow clicks so nothing behind reacts.
    TouchArea { }
    VerticalLayout {
        y: 14px * (1 - root.t);
        padding: 16px;
        padding-bottom: 8px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Image { source: @image-url("../../../ZenshiroDev/resources/assets/logo-256.png"); width: 22px; height: 22px; y: (parent.height - self.height) / 2; }
            Text { text: root.title; font-size: 14px; font-weight: 700; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            if root.window-ok: Seg {
                width: 210px;
                options: ["phone", "window"];
                labels: [I18n.t("On the phone"), I18n.t("New window")];
                value: root.open-in;
                changed(v) => { root.open-in = v; }
            }
            GlassButton { icon: "\u{E711}"; tip: I18n.t("Close"); clicked => { root.close(); } }
        }
        if !root.busy && root.searchable: Field {
            placeholder: I18n.t("Search apps…");
            edited(v) => { root.filter(v); }
        }
        if root.busy: BusyBar { }
        if root.status != "": Text { text: root.status; font-size: 11px; color: root.busy ? Theme.accent : Theme.text-3; wrap: word-wrap; }
        grid := Flickable {
            vertical-stretch: 1;
            property <int> cols: max(1, floor(self.width / 96px));
            property <length> cw: self.width / self.cols;
            content-height: ceil(root.apps.length / self.cols) * 100px;
            for a[i] in root.apps: Rectangle {
                x: mod(i, grid.cols) * grid.cw;
                y: floor(i / grid.cols) * 100px;
                width: grid.cw;
                height: 100px;
                border-radius: 16px;
                background: ta.pressed ? Theme.fill-hover.darker(10%) : ta.has-hover ? Theme.fill-hover : transparent;
                animate background { duration: 150ms; easing: ease-out; }
                ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.launch(i, root.window-ok ? root.open-in : "phone"); }
                }
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 12px + (ta.pressed ? 2px : 0px);
                    width: 50px;
                    height: 50px;
                    border-radius: 15px;
                    background: @linear-gradient(140deg, a.tint.brighter(18%) 0%, a.tint.darker(22%) 100%);
                    drop-shadow-blur: 8px;
                    drop-shadow-offset-y: 3px;
                    drop-shadow-color: a.tint.with-alpha(0.35);
                    animate y { duration: 90ms; }
                    Text { text: a.letter; font-size: 19px; font-weight: 750; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text {
                    x: 6px;
                    y: 68px;
                    width: parent.width - 12px;
                    height: 28px;
                    text: a.name;
                    font-size: 11px;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: top;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }
        }
    }
}

// Shown in Settings › About (set from Cargo's version at start).
export global AppInfo {
    in property <string> version;
    // Installed from the Microsoft Store (MSIX): the Store updates ZenLink
    // and Windows Settings > Apps > Startup controls "start with Windows".
    in property <bool> store;
}

export component AppWindow inherits Window {
    title: "ZenLink";
    icon: @image-url("../../../ZenshiroDev/resources/assets/logo-256.png");
    background: transparent;
    // Roomy start (user's choice, 2026-11-07): taller, so the Android setup
    // card fits without scrolling (the header's own minimum sets the width,
    // 824 px at 100%). Rust shrinks it to the screen's work area on small
    // screens; the first frame refits it to the picture.
    preferred-width: 620px;
    preferred-height: 900px;
    min-width: 470px; // header fits (logo, name, buttons, window controls)
    min-height: 420px;
    default-font-family: "Segoe UI Variable Text";

    in-out property <Prefs> prefs;
    in-out property <bool> settings-open: true; // Settings start open (docked at the side)
    in property <string> phase: "idle";
    in property <string> device;
    in property <string> link;
    in property <string> message;
    in property <string> stats-line;
    in property <string> stats-full;
    in property <string> driver-text;
    in property <string> connection;
    in property <bool> muted;
    in property <string> toast;
    // v2-style connect card (see Placeholder).
    in property <int> flow-step: -1;
    in property <bool> flow-failed: false;
    in property <string> flow-kind: "apple";
    in property <bool> device-wifi: false;
    in property <string> device-need;
    callback flow-dismiss();
    callback need-fix();
    // Apple device list (connected + trusted before) and the AirPlay wait.
    in property <[AppleDev]> apple-devices;
    in property <bool> apple-listening;
    in-out property <bool> firewall-blocked;
    in-out property <string> firewall-msg;
    callback allow-network();
    callback apple-pick(string);
    callback apple-forget(string);
    in property <bool> drv-restore;
    in property <bool> drv-bind;
    in property <bool> drv-filter;
    in property <bool> passcode-set;
    callback save-passcode(string);
    // Notice sheet (driver changes).
    in property <bool> sheet-open;
    in property <string> sheet-title;
    in property <string> sheet-body;
    in property <string> sheet-ok;
    in property <string> sheet-cancel;
    callback sheet-answer(bool);
    // Connection mode chooser (shown until a mode is chosen).
    in-out property <bool> chooser-open: false;
    in property <bool> chooser-cancelable: false;
    in property <string> mode-active;
    in property <string> mode-link: "wired";
    in property <bool> mode-remember: true;
    callback choose-mode(string, string, bool);
    callback set-link(string);
    // First screen and Android workspace (phase A2): platform | apple | android.
    in-out property <string> screen: "platform";
    in property <bool> apple-detected;
    in property <int> android-count;
    in property <string> android-status;
    in property <bool> adb-missing;
    in property <float> adb-progress: -1;
    in property <string> adb-error;
    callback install-adb();
    in property <[AndroidRow]> android-devices;
    in property <int> android-selected: -1;
    callback android-pick(int);
    // Android session (phase A3): "idle", "connecting", "streaming", "error".
    in property <string> android-phase: "idle";
    in property <string> android-device;
    in property <string> android-link;
    in property <string> android-message;
    in property <bool> hevc-ok;
    callback android-start(int);
    callback android-start-via(int, string);
    // v2.6 device menu (left) and the drawer under the picture.
    in property <[RailDev]> rail-devices;
    in-out property <bool> menu-open: true;
    // "Connect a device" page in the stage.
    in-out property <bool> adding;
    // Close dialog (close action "ask"); Rust acts on close-choice.
    in-out property <bool> close-ask;
    callback close-choice(string, bool);
    callback adding-opened();
    // Menu slide, 0 = closed, 1 = open (driven from Rust like `sp`).
    in property <float> mp: 1;
    // Side panel next to the menu (Screen settings or Files, one at a time).
    in property <float> pp: 0;
    in-out property <bool> drawer-screen;
    in-out property <bool> drawer-files;
    callback rail-pick(int);
    callback rail-pop(int);
    callback menu-toggled(bool);
    callback files-toggled(bool);
    callback panel-toggled(bool);
    in property <bool> android-wifi-busy;
    in property <string> android-wifi-status;
    callback android-wifi-device(int);
    callback android-wifi-connect(string);
    callback android-wifi-pair(string, string);
    in property <image> android-qr;
    in property <bool> android-qr-on;
    in property <string> android-qr-status;
    callback android-wifi-qr();
    callback android-wifi-qr-cancel();
    in property <bool> android-apps-open;
    in property <bool> android-apps-busy;
    in property <string> android-apps-title;
    in property <string> android-apps-status;
    in property <[AppRow]> android-apps;
    callback android-apps-filter(string);
    callback android-apps-close();
    in property <bool> android-apps-window-ok;
    // Files dragged over the window, and a running transfer (filedrop.rs).
    in property <bool> drop-hover;
    in property <bool> drop-ok;
    in property <bool> drop-apple;
    // iPhone/iPad: which app gets the dropped files (Apple Driver mode).
    in property <bool> files-open;
    in property <bool> files-busy;
    in property <string> files-title;
    in property <string> files-status;
    in property <[AppRow]> files-apps;
    callback files-pick(int);
    callback files-close();
    in property <string> transfer;
    in property <float> transfer-p: -1;
    out property <length> transfer-w: min(self.width - 40px, 360px);
    callback android-app-launch(int, string);
    // Launcher rectangle (logical px), kept open in the picture by Rust.
    out property <length> launcher-x: root.stage-x + 10px;
    out property <length> launcher-y: root.stage-y + 10px;
    out property <length> launcher-w: max(0px, root.stage-w - 20px);
    out property <length> launcher-h: max(0px, root.stage-h - 20px);
    callback android-stop();
    callback android-restart();
    property <bool> on-android: root.screen == "android";
    // A picture is on the stage (either platform).
    property <bool> picture: root.on-android ? root.android-phase == "streaming" : root.phase == "streaming";
    callback choose-platform(string, bool);
    callback change-platform();
    // Animated dot field (rendered in Rust) and the cursor over the stage.
    in property <[DotTile]> dots-tiles;
    // The dot field is on screen (the window draws it only then).
    out property <bool> dots-on: !root.picture && root.prefs.dots && !root.adding;
    out property <bool> stage-hover: stage-ta.has-hover;
    out property <length> stage-mouse-x: stage-ta.mouse-x;
    out property <length> stage-mouse-y: stage-ta.mouse-y;

    // Where the native video view goes (logical px). Read by Rust.
    out property <length> stage-x: stage.absolute-position.x;
    // Toast and tooltip rectangles: the picture (a child window) leaves
    // them open, else it would cover them (main.rs, VideoView::set_holes).
    out property <bool> tip-on: tip.visible;
    out property <length> tip-x: tip.x;
    out property <length> tip-y: tip.y;
    out property <length> tip-w: tip.width;
    out property <length> tip-h: tip.height;
    out property <length> toast-w: min(self.width - 40px, toast-measure.preferred-width + 32px);
    out property <length> stage-y: stage.absolute-position.y;
    out property <length> stage-w: stage.width;
    out property <length> stage-h: stage.height;
    // Everything around the picture: paddings, bars, settings.
    // Settings slide: 0 = closed, 1 = open. Spring-like ease-out (fast start,
    // soft landing), shared by the panel and the window width in Rust.
    // Settings slide progress, 0 = closed, 1 = open. Driven from Rust on the
    // same tick as the window width (B-22): a Slint animation ran ahead of
    // the window by a frame and the picture jumped while the panel slid.
    in property <float> sp: 1;
    // Materialize curves (shayann07/liquidglass, Apache-2.0): in 320 ms,
    // out 240 ms.
    out property <length> chrome-w: 16px + 368px * sp + 216px * mp + 448px * pp;
    out property <length> chrome-h: 16px + 46px + 8px + 8px + 46px;

    callback start-cast();
    callback stop-cast();
    callback restart();
    callback prefs-changed(Prefs);
    callback action(string);
    callback driver-action(string);
    in property <string> upd-status;
    in property <string> upd-version;
    in property <string> upd-notes;
    in property <bool> upd-switch;
    in property <bool> upd-busy;
    in property <float> upd-progress: -1;
    in property <string> upd-channel-own: "beta";
    callback update-action(string);
    callback settings-toggled(bool);
    callback window-action(string);
    // A key press for the device (Android); true = it was sent.
    callback key-input(string, bool, bool, bool) -> bool;
    public function focus-keys() { keys.focus(); }
    no-frame: true;
    forward-focus: keys;

    // Narrow window: icon-only buttons. Set from Rust (window width), not
    // from layout, so the layout cannot feed back into it.
    in property <bool> compact: false;
    in property <bool> is-maximized: false;
    in property <bool> fullscreen: false;
    // Picture column too narrow for labelled shortcuts.
    in property <bool> compact-bar: false;
    // Full screen / maximised: square edges to the screen border (no
    // rounded corners showing the desktop, no resize strips).
    property <bool> edge: root.fullscreen || root.is-maximized;
    // F11 toggles full screen, Esc leaves it.
    keys := FocusScope {
        key-pressed(ev) => {
            if ev.text == Key.F11 { root.window-action("fullscreen"); return accept; }
            if ev.text == Key.Escape && root.fullscreen { root.window-action("fullscreen"); return accept; }
            if root.key-input(ev.text, ev.modifiers.control, ev.modifiers.shift, ev.modifiers.alt) { return accept; }
            reject
        }
    }
    Rectangle {
        // Full screen has nothing behind the glass (Windows shows grey or
        // black there): solid theme colour instead, so light stays light.
        background: root.fullscreen ? (Theme.dark ? #121214 : #f2f2f7) : Theme.base;
        border-radius: root.edge ? 0px : 12px;
        clip: true;
        VerticalLayout {
            padding: 8px;
            spacing: 8px;
            TopBar {
                compact: root.compact;
                maximized: root.is-maximized;
                fullscreen: root.fullscreen;
                device: root.screen == "apple" ? root.device : root.on-android ? root.android-device : "";
                phase: root.screen == "apple" ? root.phase : root.on-android ? root.android-phase : "idle";
                link: root.screen == "apple" ? root.link : root.on-android ? root.android-link : "";
                need: root.screen == "apple" ? root.device-need : "";
                listening: root.screen == "apple" && root.apple-listening;
                stats: root.prefs.stats ? root.stats-line : "";
                settings-open: root.settings-open;
                muted: root.muted;
                fit: root.prefs.fit;
                window-action(a) => { root.window-action(a); }
                start => {
                    if root.screen == "apple" { root.start-cast(); }
                    if root.on-android { root.android-start(-1); }
                }
                stop => {
                    if root.on-android { root.android-stop(); } else { root.stop-cast(); }
                }
                restart => {
                    if root.screen == "apple" { root.restart(); }
                    if root.on-android { root.android-restart(); }
                }
                menu-open: root.menu-open;
                menu => {
                    root.menu-open = !root.menu-open;
                    // The side panel belongs to the menu: it closes with it.
                    if !root.menu-open && (root.drawer-screen || root.drawer-files) {
                        root.drawer-screen = false;
                        root.drawer-files = false;
                        root.files-toggled(false);
                        root.panel-toggled(false);
                    }
                    root.menu-toggled(root.menu-open);
                }
                settings => {
                    root.settings-open = !root.settings-open;
                    root.settings-toggled(root.settings-open);
                }
                mute => { root.action("mute"); }
                rotate => { root.action("rotate"); }
                fit-next => {
                    root.prefs.fit = root.prefs.fit == "contain" ? "cover" : root.prefs.fit == "cover" ? "fill" : "contain";
                    root.prefs-changed(root.prefs);
                }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;
                // Device menu: slides in from the left edge while the window grows.
                if root.mp > 0.001: Rectangle {
                    width: 216px * root.mp;
                    clip: true;
                    DeviceRail {
                        x: (root.mp - 1) * 28px;
                        width: 208px;
                        height: parent.height;
                        opacity: min(1, root.mp * 1.6);
                        devices: root.rail-devices;
                        screen-on: root.drawer-screen;
                        files-on: root.drawer-files;
                        pick(i) => { root.adding = false; root.rail-pick(i); }
                        pop(i) => { root.rail-pop(i); }
                        adding: root.adding;
                        connect => {
                            if root.drawer-screen || root.drawer-files {
                                root.drawer-screen = false;
                                root.drawer-files = false;
                                root.files-toggled(false);
                                root.panel-toggled(false);
                            }
                            root.adding = true;
                            root.adding-opened();
                        }
                        home-on: root.screen == "platform" && !root.adding;
                        home => {
                            root.adding = false;
                            if root.drawer-screen || root.drawer-files {
                                root.drawer-screen = false;
                                root.drawer-files = false;
                                root.files-toggled(false);
                                root.panel-toggled(false);
                            }
                            if root.screen != "platform" { root.change-platform(); }
                        }
                        screen => {
                            root.adding = false;
                            root.drawer-screen = !root.drawer-screen;
                            root.drawer-files = false;
                            root.panel-toggled(root.drawer-screen);
                        }
                        files => {
                            root.adding = false;
                            root.drawer-files = !root.drawer-files;
                            root.drawer-screen = false;
                            root.files-toggled(root.drawer-files);
                            root.panel-toggled(root.drawer-files);
                        }
                    }
                }
                // Side panel: the selected phone's Screen settings or Files.
                if root.pp > 0.001: Rectangle {
                    width: 448px * root.pp;
                    clip: true;
                    if root.drawer-screen: Rectangle {
                        x: (root.pp - 1) * 28px;
                        width: 440px;
                        height: parent.height;
                        opacity: min(1, root.pp * 1.6);
                        ScrollView {
                            AndroidVideoCard {
                                prefs: root.prefs;
                                hevc-ok: root.hevc-ok;
                                changed(p) => { root.prefs = p; root.prefs-changed(p); }
                            }
                        }
                    }
                    if root.drawer-files: FilePane {
                        x: (root.pp - 1) * 28px;
                        width: 440px;
                        height: parent.height;
                        opacity: min(1, root.pp * 1.6);
                        close => {
                            root.drawer-files = false;
                            root.files-toggled(false);
                            root.panel-toggled(false);
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    stage := Rectangle {
                        vertical-stretch: 1;
                        border-radius: 22px;
                        // Same glass while mirroring (owner, 2026-11-09): no black
                        // around the picture; only the animated dots stay idle-only.
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.edge;
                        clip: true;
                        stage-ta := TouchArea { }
                        // Not behind the add-device card: dots through its glass read as noise.
                        if root.dots-on: Rectangle {
                            for t in root.dots-tiles: Image {
                                x: t.x;
                                y: t.y;
                                width: t.w;
                                height: t.h;
                                source: t.img;
                                image-fit: fill;
                            }
                        }
                        if root.on-android && root.android-phase != "streaming" && !root.adding: AndroidHome {
                            status: root.android-status;
                            devices: root.android-devices;
                            phase: root.android-phase;
                            message: root.android-message;
                            prefs: root.prefs;
                            hevc-ok: root.hevc-ok;
                            prefs-changed(p) => { root.prefs = p; root.prefs-changed(p); }
                            back => { root.change-platform(); }
                            start-device(i) => { root.android-start(i); }
                            start-device-via(i, v) => { root.android-start-via(i, v); }
                            selected: root.android-selected;
                            pick-device(i) => { root.android-pick(i); }
                            wifi-busy: root.android-wifi-busy;
                            wifi-status: root.android-wifi-status;
                            wifi-device(i) => { root.android-wifi-device(i); }
                            wifi-connect(a) => { root.android-wifi-connect(a); }
                            wifi-pair(a, c) => { root.android-wifi-pair(a, c); }
                            qr-image: root.android-qr;
                            qr-on: root.android-qr-on;
                            qr-status: root.android-qr-status;
                            wifi-qr => { root.android-wifi-qr(); }
                            adb-missing: root.adb-missing;
                            adb-progress: root.adb-progress;
                            adb-error: root.adb-error;
                            install-adb => { root.install-adb(); }
                            wifi-qr-cancel => { root.android-wifi-qr-cancel(); }
                        }
                        if root.adding: AddDevice {
                            width: parent.width;
                            height: parent.height;
                            kind: root.screen == "apple" ? "apple" : "android";
                            prefs: root.prefs;
                            prefs-changed(p) => { root.prefs = p; root.prefs-changed(p); }
                            adb-missing: root.adb-missing;
                            wifi-busy: root.android-wifi-busy;
                            wifi-status: root.android-wifi-status;
                            qr-image: root.android-qr;
                            qr-on: root.android-qr-on;
                            qr-status: root.android-qr-status;
                            install-adb => { root.install-adb(); }
                            wifi-connect(a) => { root.android-wifi-connect(a); }
                            wifi-pair(a, c) => { root.android-wifi-pair(a, c); }
                            wifi-qr => { root.android-wifi-qr(); }
                            wifi-qr-cancel => { root.android-wifi-qr-cancel(); }
                            close => { root.adding = false; }
                        }
                        // HOME (v2.6): device type and Apple mode are chosen inside the stage.
                        if root.screen == "platform" && !root.adding: PlatformSelector {
                            inline: true;
                            width: parent.width;
                            height: parent.height;
                            picked: root.prefs.platform;
                            remember: root.prefs.remember-platform;
                            apple-detected: root.apple-detected;
                            android-count: root.android-count;
                            prefs: root.prefs;
                            prefs-changed(p) => { root.prefs = p; root.prefs-changed(p); }
                            choose(p, r) => { root.choose-platform(p, r); }
                        }
                        if root.chooser-open && root.screen == "apple" && !root.adding: ModeChooser {
                            inline: true;
                            width: parent.width;
                            height: parent.height;
                            cancelable: root.chooser-cancelable;
                            active: root.mode-active;
                            link: root.mode-link;
                            remember: root.mode-remember;
                            prefs: root.prefs;
                            prefs-changed(p) => { root.prefs = p; root.prefs-changed(p); }
                            choose(m, l, r) => { root.chooser-open = false; root.choose-mode(m, l, r); }
                            cancel => { root.chooser-open = false; }
                            back => { root.change-platform(); }
                        }
                        if root.screen == "apple" && root.phase != "streaming" && !root.chooser-open && !root.adding: Placeholder {
                            phase: root.phase;
                            device: root.device;
                            message: root.message;
                            flow-step: root.flow-step;
                            flow-failed: root.flow-failed;
                            flow-kind: root.flow-kind;
                            wifi: root.device-wifi;
                            need: root.device-need;
                            mode: root.mode-active;
                            link: root.mode-link;
                            set-link(l) => { root.set-link(l); }
                            change-mode => { root.driver-action("mode"); }
                            fix => { root.need-fix(); }
                            devices: root.apple-devices;
                            listening: root.apple-listening;
                            firewall-blocked: root.firewall-blocked;
                            firewall-msg: root.firewall-msg;
                            allow-network => { root.allow-network(); }
                            pick(id) => { root.apple-pick(id); }
                            forget(id) => { root.apple-forget(id); }
                            stop => { root.stop-cast(); }
                            start => { root.start-cast(); }
                            dismiss => { root.flow-dismiss(); }
                        }
                    }
                    // Phone buttons only while a phone is mirrored (not on Home or a setup screen).
                    if !root.adding && ((root.on-android && root.android-phase == "streaming")
                        || (root.screen == "apple" && root.phase == "streaming" && root.mode-active != "usbdirect")): BottomBar {
                        compact: root.compact-bar;
                        android: root.on-android;
                        action(a) => { root.action(a); }
                    }
                }
                // Slides in from the right edge while the window grows.
                if root.sp > 0.001: Rectangle {
                    width: 368px * root.sp;
                    clip: true;
                    SettingsPanel {
                    x: 8px + (1 - root.sp) * 28px;
                    width: 360px;
                    height: parent.height;
                    opacity: min(1, root.sp * 1.6);
                    prefs: root.prefs;
                    driver-text: root.driver-text;
                    connection: root.connection;
                    link: root.mode-link;
                    mode: root.mode-active;
                    screen: root.screen;
                    drv-restore: root.drv-restore;
                    drv-bind: root.drv-bind;
                    drv-filter: root.drv-filter;
                    set-link(l) => { root.set-link(l); }
                    stats-full: root.stats-full;
                    hevc-ok: root.hevc-ok;
                    changed(p) => { root.prefs = p; root.prefs-changed(p); }
                    close => { root.settings-open = false; root.settings-toggled(false); }
                    driver-action(a) => { root.driver-action(a); }
                    upd-status: root.upd-status;
                    upd-version: root.upd-version;
                    upd-notes: root.upd-notes;
                    upd-switch: root.upd-switch;
                    upd-busy: root.upd-busy;
                    upd-progress: root.upd-progress;
                    upd-channel-own: root.upd-channel-own;
                    update-action(a) => { root.update-action(a); }
                    passcode-set: root.passcode-set;
                    save-passcode(c) => { root.save-passcode(c); }
                    }
                }
            }
        }
        // Resize from every edge and corner (no system frame).
        for e in [
            { id: "n", x: 10px, y: 0px, w: -20px, h: 5px, c: MouseCursor.ns-resize },
            { id: "s", x: 10px, y: -5px, w: -20px, h: 5px, c: MouseCursor.ns-resize },
            { id: "w", x: 0px, y: 10px, w: 5px, h: -20px, c: MouseCursor.ew-resize },
            { id: "e", x: -5px, y: 10px, w: 5px, h: -20px, c: MouseCursor.ew-resize },
            { id: "nw", x: 0px, y: 0px, w: 10px, h: 10px, c: MouseCursor.nwse-resize },
            { id: "se", x: -10px, y: -10px, w: 10px, h: 10px, c: MouseCursor.nwse-resize },
            { id: "ne", x: -10px, y: 0px, w: 10px, h: 10px, c: MouseCursor.nesw-resize },
            { id: "sw", x: 0px, y: -10px, w: 10px, h: 10px, c: MouseCursor.nesw-resize },
        ]: TouchArea {
            enabled: !root.edge;
            x: e.x < 0 ? parent.width + e.x : e.x;
            y: e.y < 0 ? parent.height + e.y : e.y;
            width: e.w < 0 ? parent.width + e.w : e.w;
            height: e.h < 0 ? parent.height + e.h : e.h;
            mouse-cursor: e.c;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    root.window-action("resize-" + e.id);
                }
            }
        }
        if root.sheet-open: NoticeSheet {
            width: parent.width;
            height: parent.height;
            border-radius: root.edge ? 0px : 12px;
            title: root.sheet-title;
            body: root.sheet-body;
            ok: root.sheet-ok;
            cancel: root.sheet-cancel;
            answer(yes) => { root.sheet-answer(yes); }
        }
        if root.close-ask: CloseDialog {
            width: parent.width;
            height: parent.height;
            border-radius: root.edge ? 0px : 12px;
            choose(act, remember) => { root.close-choice(act, remember); }
        }
        // Hover tooltip: below the control, or above it near the bottom.
        tip := Rectangle {
            property <bool> above: Tip.bottom + 40px > root.height;
            width: min(tipT.preferred-width + 20px, 280px);
            height: tipT.preferred-height + 12px;
            x: max(8px, min(root.width - self.width - 8px, Tip.x - self.width / 2));
            y: above ? Tip.top - self.height - 6px : Tip.bottom + 6px;
            border-radius: 9px;
            background: Theme.dark ? #26283af2 : #ffffffee;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 3px;
            drop-shadow-color: #0000003a;
            opacity: Tip.shown ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity { delay: Tip.shown ? 350ms : 0ms; duration: 120ms; }
            tipT := Text {
                text: Tip.text;
                font-size: 11.5px;
                color: Theme.text;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width - 20px;
            }
        }
        AppLauncher {
            x: root.launcher-x;
            y: root.launcher-y;
            width: root.launcher-w;
            height: root.launcher-h;
            open: root.android-apps-open && root.on-android;
            title: root.android-apps-title;
            status: root.android-apps-status;
            busy: root.android-apps-busy;
            apps: root.android-apps;
            window-ok: root.android-apps-window-ok;
            filter(v) => { root.android-apps-filter(v); }
            launch(i, where) => { root.android-app-launch(i, where); }
            close => { root.android-apps-close(); }
        }
        // iPhone/iPad: pick the app that receives the dropped files.
        AppLauncher {
            x: root.launcher-x;
            y: root.launcher-y;
            width: root.launcher-w;
            height: root.launcher-h;
            open: root.files-open;
            title: root.files-title;
            status: root.files-status;
            busy: root.files-busy;
            apps: root.files-apps;
            window-ok: false;
            searchable: false;
            launch(i, where) => { root.files-pick(i); }
            close => { root.files-close(); }
        }
        // Files dragged in from Explorer (v2.5.1, filedrop.rs).
        Rectangle {
            x: root.launcher-x;
            y: root.launcher-y;
            width: root.launcher-w;
            height: root.launcher-h;
            border-radius: 22px;
            property <float> t: root.drop-hover ? 1 : 0;
            animate t { duration: 160ms; easing: ease-out; }
            opacity: self.t;
            visible: self.t > 0.01;
            background: Theme.dark ? #101014ee : #f4f4f8ee;
            border-width: 2px;
            border-color: root.drop-ok ? Theme.accent : Theme.warn;
            VerticalLayout {
                alignment: center;
                spacing: 10px;
                padding: 24px;
                Text {
                    text: root.drop-ok ? "\u{E898}" : "\u{E7BA}";
                    font-family: Theme.icons;
                    font-size: 40px;
                    color: root.drop-ok ? Theme.accent : Theme.warn;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.drop-ok ? I18n.t("Drop to send to the device") : root.drop-apple ? I18n.t("Sending files needs Apple Driver mode") : I18n.t("No Android phone is being mirrored");
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.text;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.drop-apple
                        ? (root.drop-ok ? I18n.t("Then pick the app on the iPhone/iPad (e.g. VLC, Documents). The file also shows in Files › On My iPhone.")
                                        : I18n.t("ZenLink Studio replaces Apple's USB driver, so it cannot send files. Switch to Apple Driver in Settings."))
                        : root.drop-ok ? I18n.t("An .apk file is installed. Other files go to the phone's Download folder.") : I18n.t("Start mirroring an Android phone, then drop files here.");
                    font-size: 12px;
                    color: Theme.text-2;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
        // File transfer progress, above the toast.
        if root.transfer != "": Glass {
            strong: true;
            x: (parent.width - self.width) / 2;
            y: parent.height - 150px;
            width: root.transfer-w;
            height: 40px;
            border-radius: 13px;
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 7px;
                padding-bottom: 7px;
                spacing: 5px;
                Text { text: root.transfer; font-size: 12px; color: Theme.text; overflow: elide; horizontal-alignment: center; }
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.fill;
                    clip: true;
                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(root.transfer-p, 0, 1);
                        height: parent.height;
                        border-radius: 2px;
                        background: Theme.accent;
                        animate width { duration: 120ms; }
                    }
                }
            }
        }
        toast-measure := Text { text: root.toast; font-size: 12.5px; visible: false; }
        if root.toast != "": Glass {
            strong: true;
            x: (parent.width - self.width) / 2;
            property <float> t: 0;
            init => { self.t = 1; }
            animate t { duration: 420ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
            opacity: self.t;
            y: parent.height - 104px + 16px * (1 - self.t); // above the dock, rises in
            width: root.toast-w;
            height: 36px;
            border-radius: 12px;
            toastT := Text { text: root.toast; font-size: 12.5px; color: Theme.text; }
        }
    }
}
