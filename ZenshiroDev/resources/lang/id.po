msgid "Connected over Wi-Fi"
msgstr "Tersambung lewat Wi-Fi"

#: apps/desktop/src/main.rs:2386
msgid "Enter the pairing address (IP:port) shown on the phone."
msgstr "Isi alamat pairing (IP:port) yang tampil di HP."

