#: apps/desktop/ui/app.slint:417
msgid "Connect the iPhone/iPad and the PC to the same Wi-Fi."
msgstr "Sambungkan iPhone/iPad dan PC ke Wi-Fi yang sama."

#: apps/desktop/ui/app.slint:418
msgid "On the iPhone/iPad, open Control Center: swipe down from the top-right corner of the screen."
msgstr "Di iPhone/iPad, buka Pusat Kontrol: usap ke bawah dari pojok kanan atas layar."

#: apps/desktop/ui/app.slint:419
msgid "Tap Screen Mirroring (the two stacked rectangles)."
msgstr "Ketuk Pencerminan Layar (ikon dua kotak bertumpuk)."

#: apps/desktop/ui/app.slint:420
msgid "Pick ZenLinkStudio. The screen shows up here."
msgstr "Pilih ZenLinkStudio. Layarnya muncul di sini."

#: apps/desktop/ui/app.slint:421
msgid "Press Start below."
msgstr "Tekan Mulai di bawah."

#: apps/desktop/ui/app.slint:427
msgid "First time only: plug in the USB cable, then press Set up Wi-Fi in Settings › Connection & driver."
msgstr "Pertama kali saja: colok kabel USB, lalu tekan Atur Wi-Fi di Pengaturan › Koneksi & driver."

#: apps/desktop/ui/app.slint:428
msgid "Unlock the iPhone/iPad, then press Start."
msgstr "Buka kunci iPhone/iPad, lalu tekan Mulai."

#: apps/desktop/ui/app.slint:429
msgid "Plug the iPhone/iPad into the PC with a USB cable."
msgstr "Colok iPhone/iPad ke PC pakai kabel USB."

#: apps/desktop/ui/app.slint:430
msgid "Unlock its screen."
msgstr "Buka kunci layarnya."

#: apps/desktop/ui/app.slint:431
msgid "If it asks \"Trust this computer?\", tap Trust and enter the passcode."
msgstr "Kalau muncul \"Percayai komputer ini?\", ketuk Percayai lalu masukkan kode sandi."

#: apps/desktop/ui/app.slint:432
msgid "First time only: turn on Developer Mode in Settings › Privacy & Security › Developer Mode, restart the device and tap Turn On. If the switch is missing, press Start once: ZenLink makes it appear."
msgstr "Pertama kali saja: nyalakan Mode Pengembang di Pengaturan › Privasi & Keamanan › Mode Pengembang, mulai ulang perangkat lalu ketuk Nyalakan. Kalau tombolnya tidak ada, tekan Mulai sekali: ZenLink akan memunculkannya."

#: apps/desktop/ui/app.slint:437
msgid "Needs Trust"
msgstr "Perlu Trust"

#: apps/desktop/ui/app.slint:438
msgid "Wi-Fi not set up"
msgstr "Wi-Fi belum siap"

#: apps/desktop/ui/app.slint:439
msgid "Choose a mode"
msgstr "Pilih mode"

#: apps/desktop/ui/app.slint:440
msgid "Needs Apple Devices"
msgstr "Perlu Apple Devices"

#: apps/desktop/ui/app.slint:441
msgid "Needs a driver"
msgstr "Perlu driver"

#: apps/desktop/ui/app.slint:442
msgid "Restore the Apple driver"
msgstr "Kembalikan driver Apple"

#: apps/desktop/ui/app.slint:443
msgid "Install the ZenLink Studio driver"
msgstr "Pasang driver ZenLink Studio"

#: apps/desktop/ui/app.slint:444
msgid "libusb-win32 is not installed"
msgstr "libusb-win32 belum terpasang"

#: apps/desktop/ui/app.slint:445
msgid "Remove the libusb0 filter first"
msgstr "Hapus filter libusb0 dulu"

#: apps/desktop/ui/app.slint:446
msgid "Choose a connection mode"
msgstr "Pilih mode koneksi"

#: apps/desktop/ui/app.slint:447
msgid "Wi-Fi is not set up yet"
msgstr "Wi-Fi belum diatur"

#: apps/desktop/ui/app.slint:448
msgid "Install Apple Devices"
msgstr "Pasang Apple Devices"

#: apps/desktop/ui/app.slint:449
msgid "Unlock it and tap Trust"
msgstr "Buka kunci dan tekan Percayai"

#: apps/desktop/ui/app.slint:450
msgid "This device uses the ZenLink Studio driver, so Apple mode cannot see it. Restore the Apple driver, or switch to ZenLink Studio."
msgstr "Perangkat ini memakai driver ZenLink Studio, jadi mode Apple tidak bisa melihatnya. Kembalikan driver Apple, atau ganti ke mode ZenLink Studio."

#: apps/desktop/ui/app.slint:451
msgid "ZenLink Studio uses the libusb0 driver on the device. Install it, or switch to Apple Driver mode."
msgstr "ZenLink Studio memakai driver libusb0 di perangkat. Pasang drivernya, atau ganti ke mode Apple Driver."

#: apps/desktop/ui/app.slint:452
msgid "Install the iOS driver of TikTok LIVE Studio or libusb-win32 once, then press Check drivers. Or use Apple Driver mode."
msgstr "Pasang driver iOS TikTok LIVE Studio atau libusb-win32 sekali, lalu tekan Periksa driver. Atau pakai mode Apple Driver."

#: apps/desktop/ui/app.slint:453
msgid "A libusb0 filter is stacked on the Apple driver. It can crash Windows."
msgstr "Filter libusb0 menumpuk di driver Apple. Ini bisa membuat Windows crash."

#: apps/desktop/ui/app.slint:454
msgid "Pick Apple Driver or ZenLink Studio to continue."
msgstr "Pilih Apple Driver atau ZenLink Studio untuk lanjut."

#: apps/desktop/ui/app.slint:455
msgid "Plug in the cable once, then press Set up Wi-Fi in Settings. Or choose Wired."
msgstr "Colokkan kabel sekali, lalu tekan Atur Wi-Fi di Pengaturan. Atau pilih Kabel."

#: apps/desktop/ui/app.slint:456
msgid "Windows sees the device, but Apple Mobile Device Service is not running. Install Apple Devices from the Microsoft Store (or iTunes), then plug the cable in again. Or switch to ZenLink Studio."
msgstr "Windows melihat perangkatnya, tapi Apple Mobile Device Service tidak berjalan. Pasang Apple Devices dari Microsoft Store (atau iTunes), lalu colok ulang kabelnya. Atau ganti ke ZenLink Studio."

#: apps/desktop/ui/app.slint:457
msgid "Unlock the device, tap Trust if it asks, then try again."
msgstr "Buka kunci perangkat, tekan Percayai (Trust) kalau muncul, lalu coba lagi."

#: apps/desktop/ui/app.slint:459
msgid "Detect device"
msgstr "Deteksi perangkat"

#: apps/desktop/ui/app.slint:459
msgid "Found on USB through the libusb0 driver"
msgstr "Ditemukan di USB lewat driver libusb0"

#: apps/desktop/ui/app.slint:460
msgid "Open the device"
msgstr "Buka perangkat"

#: apps/desktop/ui/app.slint:460
msgid "Switching it to its screen-capture mode"
msgstr "Mengalihkan ke mode tangkap layar"

#: apps/desktop/ui/app.slint:461
msgid "Check trust"
msgstr "Cek kepercayaan"

#: apps/desktop/ui/app.slint:461
msgid "Keep it unlocked while ZenLink proves this PC is trusted"
msgstr "Biarkan tidak terkunci sementara ZenLink membuktikan PC ini dipercaya"

#: apps/desktop/ui/app.slint:462
msgid "Start stream"
msgstr "Mulai stream"

#: apps/desktop/ui/app.slint:462
msgid "Receiving the screen over ZenLink Studio"
msgstr "Menerima layar lewat ZenLink Studio"

#: apps/desktop/ui/app.slint:464
msgid "Device connected"
msgstr "Perangkat tersambung"

#: apps/desktop/ui/app.slint:464
msgid "Your iPhone/iPad chose ZenLinkStudio in Screen Mirroring"
msgstr "iPhone/iPad memilih ZenLinkStudio di Pencerminan Layar"

#: apps/desktop/ui/app.slint:465
msgid "Secure connection"
msgstr "Koneksi aman"

#: apps/desktop/ui/app.slint:465
msgid "AirPlay pairing and FairPlay key exchange"
msgstr "Pairing AirPlay dan pertukaran kunci FairPlay"

#: apps/desktop/ui/app.slint:466
msgid "Receive video"
msgstr "Terima video"

#: apps/desktop/ui/app.slint:466
msgid "Decrypting the AirPlay stream"
msgstr "Mendekripsi stream AirPlay"

#: apps/desktop/ui/app.slint:467
msgid "Receiving the screen over Wi-Fi"
msgstr "Menerima layar lewat Wi-Fi"

#: apps/desktop/ui/app.slint:469
msgid "Found through Apple Mobile Device Service"
msgstr "Ditemukan lewat Apple Mobile Device Service"

#: apps/desktop/ui/app.slint:470
msgid "Opening an encrypted Wi-Fi tunnel to the device"
msgstr "Membuka tunnel Wi-Fi terenkripsi ke perangkat"

#: apps/desktop/ui/app.slint:470
msgid "Opening an encrypted USB tunnel to the device"
msgstr "Membuka tunnel USB terenkripsi ke perangkat"

#: apps/desktop/ui/app.slint:471
msgid "Prepare the device"
msgstr "Siapkan perangkat"

#: apps/desktop/ui/app.slint:471
msgid "Keep it unlocked. The first time, a small developer image is installed."
msgstr "Biarkan tidak terkunci. Pertama kali, image developer kecil dipasang."

#: apps/desktop/ui/app.slint:472
msgid "Receiving the screen in HEVC"
msgstr "Menerima layar dalam HEVC"

#: apps/desktop/ui/app.slint:529
msgid "Ready · Wi-Fi"
msgstr "Siap · Wi-Fi"

#: apps/desktop/ui/app.slint:534
